<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <h1>
      Create a new chapter by <br />
      <span>playing board games in our salon</span>
    </h1>
    <p>You can bring a friend!</p>
    <!-- !TODO qr code for /invitation-machine/continuation -->
    <p>Thumbs down to get a new activity 👎</p>
  </body>
</html>
