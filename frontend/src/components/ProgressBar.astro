---
const { currentStep = 1 } = Astro.props;
const totalSteps = 4;
---

<style>
  .wrapper {
    display: grid;
    grid-template-columns: auto 1fr auto;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
  }

  a:visited {
    text-decoration: none;
  }

  .progress {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
  }

  .square {
    border: 2px solid var(--blue);
    width: 15px;
    height: 15px;
    position: relative;
  }

  .square.filled {
    background-color: var(--blue);
  }

  .square:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: 0.6rem; /* length of line */
    height: 2px;
    background-color: var(--blue);
    transform: translateY(-50%);
  }

  @media (orientation: landscape) {
    .wrapper {
      grid-column: 1 / 3;
      background: var(--yellow);
    }
  }
</style>
<div class="wrapper">
  <a class="button button--back" href={Astro.props.backLink}>back</a>
  <div class="progress">
    {
      Array.from({ length: totalSteps }).map((_, i) => (
        <div class={`square ${i < currentStep ? "filled" : ""}`} />
      ))
    }
  </div>
  <a class="button" href={Astro.props.nextLink}>next</a>
</div>
