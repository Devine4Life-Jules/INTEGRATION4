---
// Props
const { id = "dialog-window", title = "Dialog", children, image, display="null" } = Astro.props;
import AbbyWorkshop from "../assets/images/abbyWorkshop.webp"
---

<style>
.overlay {
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  animation: fadeInOpacity 0.2s ease-out 1s forwards;
  opacity: 0;
}

.dialog {
  background-color: var(--green);
  padding: 2rem;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  animation: fadeInScale 0.2s ease-out 1s forwards;
  transform: scale(0);
}


  .dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .close-button {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  figure {
    max-height: 300PX;
    margin-bottom: 1.5rem;
  }

  figure img {
    width: 100%;
  }

  a {
    background-color: var(--yellow);
    text-decoration: none;
    color: var(--black);
    padding: .5rem;
    margin-top: .5rem;
  }

  #hidden {
    display: none;
  }

  @keyframes fadeInScale {
    from {transform: scale(0); }
    to {transform: scale(1); }
  }

    @keyframes fadeInOpacity {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<div id={id} class="overlay">
  <div class="dialog" onclick="event.stopPropagation()">
    <div class="dialog-header">
      <h2>{title}</h2>
      <button class="close-button" onclick={`document.getElementById('${id}').style.display = 'none'`}>&times;</button>
    </div>
    <div class="dialog-body">
      <slot />
      <figure  style={`display: ${display};`}>
        <img src={AbbyWorkshop.src} alt="abbyWorkshop">
      </figure>
      <a href="https://www.abbykortrijk.be/bezoek/kalender" style={`display: ${display};`}>Calendar</a>
    </div>
  </div>
</div>
