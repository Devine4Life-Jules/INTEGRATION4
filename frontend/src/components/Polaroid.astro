---
import { Image } from "astro:assets";
import keyBlue from "../assets/illustrations/keyBlue.svg";
import Friends from "../assets/images/bringFriend.png";

const { pic, names } = Astro.props;
---

<style>
  .polaroid {
    background-color: white;
    max-width: 50vw;
    padding-top: 2rem;
    /* padding-bottom: 5rem; */
    grid-column: 1;
    grid-row: 1;
    position: relative;
  }

  .picture {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  figure img {
    width: 100%;
    object-fit: cover;
  }

  figure {
    margin: 0 auto;
    width: 90%;
    max-width: 400px;
    aspect-ratio: 1/1;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .polaroidBottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    text-align: end;
  }

  .key {
    margin: 0;
    width: 7vw;
    margin-right: auto;
  }
</style>

<div class="polaroid">
  <figure>
    <Image class={"picture"} src={pic} alt="people of abby" />
  </figure>
  <div class="polaroidBottom">
    <figure class="key"><img src={keyBlue.src} alt="bluekey" /></figure>
    <p>{names}</p>
  </div>
</div>
