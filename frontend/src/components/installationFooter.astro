---
import logo from '../assets/images/logoBlack.svg'
import Tape from '../components/Tape.astro'
---

<style>
 footer {
    margin-top: auto;
    background-color: var(--white);
 }

 .logo {
    width: 7rem;
 }
  

</style>

<footer>
    <Tape text={Astro.props.text}></Tape>
    <figure class="logo">
        <img src={logo.src} alt="">
    </figure>
</footer>
