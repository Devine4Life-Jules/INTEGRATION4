---
import AbbySvg from "../assets/illustrations/abby-kortrijk.svg";
const { mobileBgColor, desktopBgColor } = Astro.props;

const colorMap = {
  yellow: "var(--yellow)",
  white: "var(--white)",
  blue: "var(--blue)",
  green: "var(--green)",
};

const mobileColor = colorMap[mobileBgColor] ?? "var(--white)";
const desktopColor = colorMap[desktopBgColor] ?? "var(--white)";

---



    <style>

    footer {
        padding: 1.3rem;
    }

    @media screen and (min-width: 100px){
    footer {
      display: block;
      background-color: var(--bg-mobile);

    }

    }

    
       

    @media screen and (min-width: 500px){


    footer {
      grid-row: 4;
      grid-column: 1 / 3;
      height: 100%;
      background-color: var(--bg-desktop);


    }

}



    </style>

<footer style={`--bg-mobile: ${mobileColor}; --bg-desktop: ${desktopColor};`}>
  <div class="footerLogo">
    <img src={AbbySvg.src} alt="Abby logo" />
  </div>
</footer>