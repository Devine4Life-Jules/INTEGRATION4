---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { ClientRouter } from "astro:transitions";
import InstallationFooter from "../../components/InstallationFooter.astro";
import pin from "../../assets/illustrations/location.svg"
import thumbsDown from "../../assets/illustrations/thumbsDown.svg"
---

<style>

  body {
    background-color: var(--yellow);
  }

#qr{
  background-color: white;
}

.headerIntro {
  font-size: 2rem;
}

h1 {
  margin-top: 14rem;
  font-size: 4rem;
  font-weight: 500;
  max-width: 60vw;
  line-height: 1;
  margin: 7rem auto 4rem; 
}

.locationLabel{
  background-color: var(--blue);
  display: flex;
  display: inline-flex;
  align-items: center;
  margin-right: auto;
  margin-top: -2rem;
  margin-left: -2rem;
  padding: .3rem;
  padding-right: 1rem;
  font-weight: 500;
  font-size: 2.5rem;
  



}


.accent {
  display: block;
  font-weight: 800;
  font-size: 2rem;
}

.other {
  font-weight: 800;
  font-size: 1.5rem;
}

#activity {
  font-weight: 800;
  font-size: 6rem;
  display: block;
  line-height: 1.3;
}


.thumbsDownLabel {
  background-color: var(--purple);
  display: flex;
  align-items: center;
  width: 15rem;
  align-self: flex-end;
  margin-left: auto;
  margin-bottom: -2rem;
  margin-right: -2rem;
  padding: .3rem;
  overflow: visible;


}

@keyframes bounceDown {

  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(10px); 
  }
}

.thumbsDownLabel img {
  animation: bounceDown 1s ease-in-out infinite;
  animation-delay: 3s;
  overflow: visible;
}


.qrWrapper {
  width: 50vw;
  margin: 0 auto;
  background-color: white;
  margin-top: 5rem;
  
}

h1 {
  text-align: center;
}

</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <script defer src="https://cdn.jsdelivr.net/npm/ml5@1.2.1/dist/ml5.min.js"
    ></script>
  </head>
  <body class="installationBody">
    <h1>
      <span class="headerIntro">We've picked a fun activity for you</span> <br />
      <span id="activity">playing <span class="blueBg">Boardgames</span></span>
    </h1>
    <div class="qrWrapper">
      <div class="locationLabel">
        <figure>
          <img src={pin.src} alt="location pin">
        </figure>
        <div>
          <p>Abby, Salon</p>
        </div>
      </div>
      <div class="scan">scan qr code to <span class="accent">Accept Activity</span></div>
      <video width="600" height="600" class="hidden"></video>
      <canvas width="600" height="600" class="hidden"></canvas>
      <canvas id="qr"></canvas>
      <!-- !TODO qr code for /invitation-machine/continuation -->
            <div class="thumbsDownLabel">
        <figure>
          <img src={thumbsDown.src} alt="thumbsdown">
        </figure>
        <div class="thumbsDownDescription">
          <div>Show Thumbs down for</div>
          <div class="other">Other Activity</div>
        </div>
      </div>
      
    </div>
    <InstallationFooter text="you are the key"></InstallationFooter>
  </body>
</html>

<script>
  import { gsap } from "gsap"
  import { handleHandPose } from "../../scripts/invitation-machine/handlePose";
  import checkDislike from "../../scripts/invitation-machine/checkDislike";
  import handleReset from "../../scripts/handleReset";
  import changeActivity from "../../scripts/invitation-machine/4/changeActivity";

  console.log("GSAP loaded?", typeof gsap === "function" || typeof gsap === "object");
  console.log("GSAP version:", gsap.version);


  let inactivityTimer;

  
  const resetInactivityTimer = () => {
  clearTimeout(inactivityTimer);
  inactivityTimer = setTimeout(() => {
    window.location.href = "/invitation-machine/1";
  }, 3000); 
}


    ["mousemove", "keydown", "touchstart"].forEach((event) =>
      window.addEventListener(event, resetInactivityTimer)
    );


resetInactivityTimer();

  const tl = gsap.timeline()
  const tlDuration = .6

  tl.from(".headerIntro",{
    opacity:0,
    scale: 0,
    duration: tlDuration
  }).from("#activity",{
    opacity:0,
    scale: 0,
    duration: tlDuration
  })

  console.log("js loaded");



  changeActivity();
  handleHandPose((pose: any) => {
    checkDislike(pose, () => {
      if (new URL(location.href).pathname !== "/invitation-machine/4") return;
      changeActivity();
    });
  });
  // handleReset();
</script>
