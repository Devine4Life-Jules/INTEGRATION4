---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { ClientRouter } from "astro:transitions";
import InstallationFooter from "../../components/InstallationFooter.astro";
import pin from "../../assets/illustrations/location.svg"
import thumbsDown from "../../assets/illustrations/thumbsDown.svg"
---

<style>

#qr{
  background-color: white;
}

.headerIntro {
  font-size: 2rem;
}

h1 {
  font-size: 4rem;
  font-weight: 500;
}

.locationLabel{
  background-color: var(--blue);
  display: flex;
  width: 10rem;
  align-items: center;
  margin-right: auto;
}



.thumbsDownLabel {
  background-color: var(--purple);
  display: flex;
  align-items: center;
  width: 15rem;
  align-self: flex-end;
  margin-left: auto;
  margin-top: 0;

}

.qrWrapper {
  width: 50vw;
  height: 50vh;
  margin: 0 auto;
  
}

h1 {
  text-align: center;
}

</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <script defer src="https://cdn.jsdelivr.net/npm/ml5@1.2.1/dist/ml5.min.js"
    ></script>
  </head>
  <body class="installationBody">
    <h1>
      <span class="headerIntro">we've picked a fun activity for you</span> <br />
      <span id="activity">playing boardgames</span>
    </h1>
    <div class="qrWrapper">
      <div class="locationLabel">
        <figure>
          <img src={pin.src} alt="location pin">
        </figure>
        <div>
          <p>Abby, Salon</p>
        </div>
      </div>
      <video width="600" height="600" class="hidden"></video>
      <canvas width="600" height="600" class="hidden"></canvas>
      <canvas id="qr"></canvas>
      <!-- !TODO qr code for /invitation-machine/continuation -->
      <div class="thumbsDownLabel">
        <figure>
          <img src={thumbsDown.src} alt="thumbsdown">
        </figure>
        <div class="thumbsDownDescription">
          <div>Thumbs down for</div>
          <div>new activity</div>
        </div>
      </div>
    </div>
    You can enjoy it solo, or bring a friend along 
    <InstallationFooter text="you are the key"></InstallationFooter>
  </body>
</html>

<script>
  import { handleHandPose } from "../../scripts/invitation-machine/handlePose";
  import checkDislike from "../../scripts/invitation-machine/checkDislike";
  import handleReset from "../../scripts/handleReset";
  import changeActivity from "../../scripts/invitation-machine/4/changeActivity";

  changeActivity();
  handleHandPose((pose: any) => {
    checkDislike(pose, () => {
      if (new URL(location.href).pathname !== "/invitation-machine/4") return;
      changeActivity();
    });
  });
  // handleReset();
</script>
