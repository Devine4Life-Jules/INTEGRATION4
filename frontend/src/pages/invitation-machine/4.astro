---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <script defer src="https://cdn.jsdelivr.net/npm/ml5@1.2.1/dist/ml5.min.js"
    ></script>
  </head>
  <body>
    <h1>
      Create a new chapter by <br />
      <span id="activity">playing board games in our salon</span>
    </h1>
    <p>You can bring a friend!</p>
    <video width="600" height="600" class="hidden"></video>
    <canvas width="600" height="600" class="hidden"></canvas>
    <canvas id="qr"></canvas>
    <!-- !TODO qr code for /invitation-machine/continuation -->
    <p>Thumbs down to get a new activity 👎</p>
  </body>
</html>

<script>
  import { handleHandPose } from "../../scripts/invitation-machine/handlePose";
  import checkDislike from "../../scripts/invitation-machine/checkDislike";
  import handleReset from "../../scripts/handleReset";
  import changeActivity from "../../scripts/invitation-machine/4/changeActivity";

  changeActivity();
  handleHandPose((pose: any) => checkDislike(pose, changeActivity));
  handleReset();
</script>
