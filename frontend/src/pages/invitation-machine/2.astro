---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { ClientRouter } from "astro:transitions";
import PolaroidStack from "../../components/PolaroidStack.astro";
import InstallationFooter from "../../components/InstallationFooter.astro";
import smileyOrange from "../../assets/illustrations/smileyOrange.svg"
---
<style>
  .headerBold {
    display: flex;
    align-items: flex-end;
  }

  .smileyOrange {
    margin-left: 1.5rem;
  }

  body {
    padding-top: 6rem;
  }

  
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <script defer src="https://cdn.jsdelivr.net/npm/ml5@1.2.1/dist/ml5.min.js"
    ></script>
  </head>
  <body class="installationBody">
    <h1 class="firstTitle">
      <div class="headerBold">Good Job<figure class="smileyOrange"><img src={smileyOrange.src} alt="orange smiley"></figure></div>
      <span class="bottomTitle"></span>Story unlocked</span>
    </h1>
    <PolaroidStack></PolaroidStack>
    <InstallationFooter text="You are the key"></InstallationFooter>
    <!-- !TODO stories visualization -->
  </body>
</html>

<script>
  import { navigate } from "astro:transitions/client";
  import gsap from "gsap";

         gsap.from("h1", {
        opacity: 0,
        x: -300,
      })
  

  // setTimeout(() => navigate("/invitation-machine/3"), 4000);
</script>
