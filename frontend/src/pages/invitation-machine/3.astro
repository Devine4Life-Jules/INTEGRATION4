---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { ClientRouter } from "astro:transitions";
import InstallationFooter from "../../components/InstallationFooter.astro";
import thumbs from "../../assets/illustrations/thumbsUp.svg"
---

<style>



  #canvas {
  display: block;
  width: 50vw;
  height: 25vh;
    
  }

  p {
    line-height: 1;
  }

  .thumbsUp {
    display: block;
    max-height: 5rem;
  }

  body {
    padding-top: 6rem;
    background-color: var(--yellow);

  }

  .videoBox{
    
    background-color: var(--white);
    margin: 3rem auto;
    padding: 2rem;
    width: 50vw;
  }

  .videoDescripton {
    display: flex;
    justify-content: center;
    gap: 1rem;
    align-items: center;
    text-align: center;

  
  }

  .videoDescripton p {
    font-size: 1.9rem;
  }


  .firstTitle {
    text-align: center;
  }
  

  h1 {
    text-align: center;
  }

</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
    <script defer src="https://cdn.jsdelivr.net/npm/ml5@1.2.1/dist/ml5.min.js"
    ></script>
  </head>
  <body class="installationBody">
    <h1 class="firstTitle">It's your turn to shape the <span class="blueBg">new chapter</span></h1>
    <video width="1000" height="1200" class="hidden" id="video"></video>
    <div class="videoBox">
      <canvas width="1000" height="1200" id="canvas"></canvas>
      <div class="videoDescripton">
        <img class="thumbsUp" src={thumbs.src} alt="thumbsUp"><div>
          <p>show thumbs</p><p> up to continue</p>
        </div><img class="thumbsUp" src={thumbs.src} alt="thumbsUp">
      </div>
    </div>
    <!-- !TODO visualization of a user story -->
     <InstallationFooter text="you are the key"></InstallationFooter>

  </body>
</html>

<script>
  import { handleHandPose } from "../../scripts/invitation-machine/handlePose";
  import checkLike from "../../scripts/invitation-machine/checkLike";
  import { navigate } from "astro:transitions/client";

  // import { gsap } from "gsap";

  const tlDuration = .5
  const tl = gsap.timeline();

  tl.from(".firstTitle", {
    opacity:0,
    duration: tlDuration,
  }).from(".videoBox", {
    scale:0,
    opacity:0,
    
    duration:tlDuration
  })

  handleHandPose((pose: any) => {
    if (new URL(location.href).pathname !== "/invitation-machine/3") return;
    checkLike(pose, () => {
      navigate("/invitation-machine/4");
    });
  });

  const $video = document.querySelector("#video") as HTMLVideoElement;
  const $canvas = document.querySelector("#canvas") as HTMLCanvasElement;
  const ctx = $canvas.getContext("2d");

    const getXImgOffset = () => {
    const videoCanvasRatio = $canvas.height / $video.height;
    const newVideoWidth = $video.width * videoCanvasRatio;
    const diffrence = newVideoWidth - $canvas.width;

    return {
      xOffset: diffrence / 2,
      imageWidth: $video.width * videoCanvasRatio,
    };
  };

    const draw = () => {
    const { xOffset, imageWidth } = getXImgOffset();

    ctx?.drawImage($video, -xOffset, 0, imageWidth, 1111);
    
    requestAnimationFrame(draw);
  };
  draw();



</script>
