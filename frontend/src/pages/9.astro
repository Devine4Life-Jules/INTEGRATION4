---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import ContinuationProgress from "../components/ContinuationProgress.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img src={AbbyLogoSvg.src} alt="Abby logo" />
    <h1>Because stories are better together</h1>
    <div>
      <!-- !TODO <Image /> -->
      <span>Share the moment</span>
    </div>
    <ContinuationProgress />
    <p>
      Come
      <span class="bold">alone</span> or <span class="bold">bring a friend</span
      > it’s totally up to you. If you want to share the moment, feel free to invite
      them to join your chapter.
    </p>
    <div class="buttons">
      <a href="./8">Back</a>
      <a href="./10">Next</a>
    </div>
  </body>
</html>
