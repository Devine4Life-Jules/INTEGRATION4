---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import ProgressBar from "../components/ProgressBar.astro";
import bringFriend from "../assets/images/newChapter.png";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto auto auto 1fr max-content;
    grid-template-columns: 1fr;
    height: 100vh;
  }

  body > * {
    grid-column: 1/2;
  }

  .label,
  .logo,
  .title {
    background-color: var(--yellow);
  }

  .logo {
    padding: var(--screen-padding) var(--screen-padding) 0 var(--screen-padding);
    padding-bottom: 1em;
  }

  .title {
    line-height: 1.1;
    padding: 0 var(--screen-padding);
    padding-bottom: 1em;
  }

  .label {
    grid-row: 3/4;
    z-index: 100;
    width: min-content;
    height: max-content;
    white-space: nowrap;
    padding: 0.4em;
    margin: var(--screen-padding);
    align-self: flex-end;
    justify-self: flex-start;
  }

  .picture {
    grid-row: 3/4;
  }

  .chapter {
    display: none;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container__p {
    padding-top: 0.2em;
  }

  @media (orientation: landscape) {
    body {
      grid-template-columns: auto auto;
    }

    .logo,
    .title {
      background-color: var(--white);
    }

    .chapter {
      display: initial;
      grid-row: 1/2;
      grid-column: 1/2;
      font-size: 2.25rem;
      padding: var(--screen-padding);
      padding-bottom: 0;
    }

    .picture {
      grid-row: 1/5;
      grid-column: 2/3;
      height: 100%;
      object-fit: cover;
    }

    .logo {
      grid-column: 2/3;
      grid-row: 1/2;
      z-index: 100;
      padding: var(--screen-padding);
      background: none;
      justify-self: flex-end;
    }

    .title {
      grid-column: 1/2;
      grid-row: 2/3;
      font-size: 4rem;
      line-height: 1;
      padding: 0 var(--screen-padding);
      margin-bottom: 0em;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .label {
      grid-row: 3/4;
      grid-column: 1/2;
      margin-left: var(--screen-padding);
      white-space: nowrap;
      margin-right: 1.5em;
    }

    .text-container {
      grid-row: 4/5;
      grid-column: 1/2;
      margin-top: auto;
      align-self: flex-end;
      text-align: left;
      max-width: 48rem;
    }

    .text-container__title {
      font-size: 2.5rem;
      font-weight: 500;
    }

    .text-container__p {
      font-size: 1.5rem;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <span class="chapter">How it works</span>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <h1 class="title">
      Because stories are better <span class="title__highlight">toghether</span>
    </h1>
    <span class="label">share the moment</span>
    <img class="picture" src={bringFriend.src} alt="friend group at abby" />
    <div class="text-container">
      <h2 class="text-container__title">Come alone or with friends</h2>
      <p class="text-container__p">
        If you want to share the moment, feel free to send them a personal
        invite to your chapter.
      </p>
    </div>
    <ProgressBar currentStep={4} backLink="/8" nextLink="/10" />
  </body>
</html>
