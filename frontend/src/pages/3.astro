---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Tape from "../components/Tape.astro";
import newChapter from "../assets/images/newChapter.png";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    display: grid;
    grid-template-rows: min-content min-content minmax(10rem, 50vh) 1fr min-content;
    height: 100vh;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container__p {
    padding-top: 0.2em;
  }

  .title {
    background-color: var(--yellow);
    padding: 1rem;
    font-size: 2.8rem;
  }

  .picture {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .picture__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .buttons {
    display: flex;
    padding: var(--screen-padding);
    justify-content: space-between;
  }

  @media (orientation: landscape) {
    body {
      grid-template-rows: min-content auto auto min-content;
      grid-template-columns: 1fr 1fr;
      height: 100vh;
    }

    h1 {
      grid-column: 1;
      font-size: 4rem;
    }

    .picture {
      object-fit: cover;
    }

    .areYouDown {
      grid-column: 1;
      grid-row: 3;
      display: block;
      background-color: var(--yellow);
    }

    .newChapterPic {
      grid-row: 2 / 4;
      overflow: hidden; /* Optional, prevents spillover */
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }

    .newChapterPic img {
      height: auto;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .tapeWrapper {
      grid-column: 1 / 3;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Tape text="you are the key" />
    <h1 class="title">
      <span class="title__highlight">You shape</span>
      the new chapter
    </h1>
    <div class="picture">
      <img
        class="picture__img"
        src={newChapter.src}
        alt="me and the boys walking through museum"
      />
    </div>
    <div class="text-container">
      <h2 class="text-container__title">Are you down for some fun?</h2>
      <p class="text-container__p">click "next" if you're in!</p>
    </div>
    <div class="buttons">
      <img class="logo-global" src={AbbyKortrijkSvg.src} alt="Abby logo" />
      <a href="/4" class="button">Next</a>
    </div>
  </body>
</html>
