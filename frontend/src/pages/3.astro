---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Tape from "../components/Tape.astro";
import newChapter from "../assets/images/newChapter.png";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    display: grid;
    grid-template-rows: min-content min-content minmax(10rem, 50vh) 1fr min-content;
    height: 100vh;
    background-color: var(--yellow);
  }

  .title {
    background-color: var(--yellow);
    padding: var(--screen-padding);
    font-size: 2.8rem;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container__p {
    padding-top: 0.2em;
  }

  .picture {
    object-fit: cover;
  }

  .buttons {
    display: flex;
    padding: var(--screen-padding);
    justify-content: space-between;
    background-color: var(--white);
  }

  @media (orientation: landscape) {
    body {
      grid-template-rows: min-content auto 1fr auto;
      grid-template-columns: 1fr 1fr;
    }

    .title {
      grid-column: 1/2;
      font-size: 4rem;
    }

    .text-container {
      grid-column: 1/2;
      grid-row: 3/4;
      align-self: flex-end;
      background-color: var(--yellow);
    }

    .picture {
      grid-row: 2/4;
      grid-column: 2/3;
    }

    .buttons {
      grid-column: 1/3;
      grid-row: 4/5;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Tape text="you are the key" />
    <h1 class="title">
      <span class="title__highlight">You shape</span>
      the new chapter
    </h1>
    <img
      class="picture"
      src={newChapter.src}
      alt="me and the boys walking through museum"
    />
    <div class="text-container">
      <h2 class="text-container__title">Are you down for some fun?</h2>
      <p class="text-container__p">click "next" if you're in!</p>
    </div>
    <div class="buttons">
      <img class="logo-global" src={AbbyKortrijkSvg.src} alt="Abby logo" />
      <a href="/4" class="button">Next</a>
    </div>
  </body>
</html>
