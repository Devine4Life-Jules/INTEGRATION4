---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Tape from "../components/Tape.astro";
import AbbyLogoSvg from "../assets/icons/abby-kortrijk.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Tape text="you are the key" />
    <h1><span>You shape</span> the new chapter</h1>
    <!-- !TODO image -->
    <div>
      <p>Are you down for some fun?</p>
      <p>Accept if you're in!</p>
    </div>
    <footer>
      <img src={AbbyLogoSvg.src} alt="Abby logo" />
      <a href="/4">Next</a>
    </footer>
  </body>
</html>
