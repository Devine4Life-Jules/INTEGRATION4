---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/icons/abby-kortrijk.svg";
---

<style>
  body {
    background-color: var(--blue);
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <!-- !TODO image -->

    <h1>
      <span>We've picked a fun activity for you!</span>
      <span>Play board games</span>
      in living room
    </h1>
    <p>You can enjoy it solo — or bring a friend along to join your chapter</p>
    <footer>
      <img src={AbbyLogoSvg.src} alt="Abby logo" />
      <div>
        <a href="/5">Accept</a>
        <button>Another Activity</button>
      </div>
    </footer>
  </body>
</html>
