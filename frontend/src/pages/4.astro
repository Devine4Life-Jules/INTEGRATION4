---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import boardGames from "../assets/images/boardGames.png";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
import { Image } from "astro:assets";
import second from "";
---

<style>
  body {
    display: grid;
    grid-template-rows: max-content max-content max-content max-content auto 1fr;
  }

  .logo,
  .title,
  .info,
  .description {
    background-color: var(--yellow);
    padding: 0 var(--screen-padding);
  }

  .logo {
    padding-top: var(--screen-padding);
    padding-bottom: 2em;
  }

  .title {
    line-height: 1.2;
    padding-bottom: 0.3em;
    font-size: 2.3rem;
  }

  .title__highlight {
    font-weight: 700;
  }

  .info {
    font-size: 1.2rem;
    font-weight: 300;
  }

  .description {
    font-size: 1.2rem;
    padding-bottom: 0.5em;
  }

  .picture {
    max-height: 50vh;
    width: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    padding: var(--screen-padding);
    align-items: flex-end;
  }

  @media (orientation: landscape) {
    body {
      grid-template-rows: auto 1fr auto min-content;
      grid-template-columns: auto auto;
      height: 100vh;
    }

    .info {
      padding-top: var(--screen-padding);
      padding-bottom: 0.5em;
      font-size: 1.8rem;
      font-weight: 400;
    }

    .logo {
      grid-column: 1/2;
      grid-row: 4/5;
      background: none;
      display: flex;
      align-items: center;
    }

    .title {
      font-size: 4rem;
      line-height: 1.2;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .description {
      align-self: flex-end;
      padding-bottom: var(--screen-padding);
    }

    .picture {
      grid-column: 1/2;
      grid-row: 1 / 4;
      height: 100%;
      object-fit: cover;
      max-height: unset;
    }

    .buttons {
      grid-row: 4/5;
      grid-column: 2/3;
      justify-content: flex-end;
      gap: 1em;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img src={AbbyKortrijkSvg.src} alt="Abby icon" />
    </div>
    <span class="info"> We've picked a fun activity for you!</span>
    <h1 class="title">
      <span class="title__highlight">Play board games</span>
      <span class="title__location"> in our living room </span>
    </h1>
    <p class="description">
      You can enjoy it solo — or bring a friend along to join your chapter
    </p>
    <!-- <img
      class="activity-img active"
      id="img-boardgames"
      src={boardGames.src}
      alt="Play Boardgames"
    />
    <img
      class="activity-img hidden"
      id="img-frisbee"
      src={frisbee.src}
      alt="Play frisbee"
    />
    <img
      class="activity-img hidden"
      id="img-cafe"
      src={cafe.src}
      alt="Make a drink"
    />
    <img
      class="activity-img hidden"
      id="img-drawing"
      src={drawing.src}
      alt="Drawing session"
    /> -->
    <Image
      class="picture"
      id="img-boardgames"
      src={boardGames}
      alt="board games"
    />
    <div class="buttons">
      <button class="buttons__another button button--back"
        >Another Activity</button
      >
      <a href="/5" class="button">Accept</a>
    </div>
  </body>
</html>

<script>
  import { gsap, Power1 } from "gsap";
  // const tl = gsap.timeline();
  // const tlDuration = 0.4;

  // tl.from(".wePicked", {
  //   opacity: 0,
  //   x: -50,
  //   duration: tlDuration,
  //   ease: Power1.easeOut,
  // })
  //   .from(".blueBg", {
  //     opacity: 0,
  //     x: -50,
  //     duration: tlDuration,
  //     ease: Power1.easeOut,
  //   })
  //   .from(".location", {
  //     opacity: 0,
  //     x: -50,
  //     duration: tlDuration,
  //     ease: Power1.easeOut,
  //   })
  //   .from("p", {
  //     opacity: 0,
  //     x: -50,
  //     duration: tlDuration,
  //     ease: Power1.easeOut,
  //   });

  const activities = [
    {
      name: "Play Boardgames",
      location: "salon",
      imgId: "img-boardgames",
    },
    {
      name: "Play frisbee",
      location: "garden",
      imgId: "img-frisbee",
    },
    {
      name: "Make a drink",
      location: "café",
      imgId: "img-cafe",
    },
    {
      name: "Drawing session",
      location: "atelier",
      imgId: "img-drawing",
    },
  ];

  let currentImgId = "img-boardgames";

  const getRandomActivity = () => {
    let next;
    do {
      next = activities[Math.floor(Math.random() * activities.length)];
    } while (next.imgId === currentImgId);
    return next;
  };

  const updateActivity = () => {
    const activity = getRandomActivity();

    document.querySelector(".title__highlight").textContent = activity.name;
    document.querySelector(".title__location").textContent =
      "in " + activity.location;

    // document.getElementById(currentImgId).classList.remove("active");
    // document.getElementById(currentImgId).classList.add("hidden");

    // document.getElementById(activity.imgId).classList.add("active");
    // document.getElementById(activity.imgId).classList.remove("hidden");

    currentImgId = activity.imgId;
  };

  document
    .querySelector(".buttons__another")
    .addEventListener("click", updateActivity);
</script>
