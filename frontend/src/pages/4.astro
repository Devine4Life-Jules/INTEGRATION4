---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import WebFooter from "../components/WebFooter.astro";
import  boardGames from "../assets/images/boardGames.png"
import Tape from "../components/Tape.astro";
---

<style>
  body {
    background-color: var(--yellow);
  }

  @media screen and (min-width:100px) {
    body {
      display: flex;
      flex-direction: column;
      height: 100vh;
      justify-content: flex-end;
    }


    header {
      margin-bottom: auto;
      padding: 1rem;

    }
    
  }

  @media screen and (min-width:500px) {
        body {
          display: grid;
          grid-template-rows: auto auto auto 7rem;
          grid-template-columns: 2fr 3fr;
          height: 100vh;
        }

        figure {
          grid-column:1 ;
          grid-row: 1;
          grid-row: 1 / 4;
          align-self: end;
          background-color: blue;
          height: 100%;
        
        }

          figure img {
            object-fit: fill;
            height: 100%;
          }

        header {
          grid-column: 2;
        }

       
        
  }

</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    

      <header>
        <span class="wePicked">We've picked a fun activity for you!</span>
            <h1>
        
        <span class="blueBg">Play board games</span>
        in living room
            </h1>
            <p>You can enjoy it solo — or bring a friend along to join your chapter</p>
      </header>
    <figure>
      <img src={boardGames.src} alt="">
    </figure>
    <WebFooter>
      <div slot="buttons" class="footerButtons">
       
        <a href="/4" class="footerBtn--secondary">Another Activity</a>
        <a href="/5" class="footerBtn">Accept</a>
      </div>

    </WebFooter>
  </body>
</html>
