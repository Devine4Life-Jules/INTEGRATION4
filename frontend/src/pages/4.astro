---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import boardGames from "../assets/images/boardGames.png";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    display: grid;
    grid-template-rows: max-content max-content max-content max-content auto 1fr;
  }

  .logo,
  .title,
  .info,
  .description {
    background-color: var(--yellow);
    padding: 0 var(--screen-padding);
  }

  .logo {
    padding-top: var(--screen-padding);
    padding-bottom: 2em;
  }

  .title {
    line-height: 1.2;
    padding-bottom: 0.3em;
  }

  .title__highlight {
    font-weight: 700;
  }

  .info {
    font-size: 1.4rem;
  }

  .description {
    font-size: 1.313rem;
  }

  .picture {
    max-height: 50vh;
    width: 100%;
    object-fit: cover;
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    padding: var(--screen-padding);
    align-items: flex-end;
  }

  @media (orientation: landscape) {
    body {
      grid-template-rows: auto auto auto 7rem;
      grid-template-columns: 2fr 3fr;
      height: 100vh;
    }

    .title {
      font-size: 4rem;
      line-height: 1.3;
      margin-bottom: auto;
    }

    header {
      height: 100%;
      grid-column: 2;
      grid-row: 1 / 4;
      display: flex;
      flex-direction: column;
    }

    figure {
      grid-column: 1;
      grid-row: 1 / 4;
      align-self: end;
      height: 100%;
    }

    figure img {
      object-fit: fill;
      height: 100%;
    }

    header {
      grid-column: 2;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img src={AbbyKortrijkSvg.src} alt="Abby icon" />
    </div>
    <span class="info">We've picked a fun activity for you!</span>
    <h1 class="title">
      <span class="title__highlight">Play board games</span>
      in our living room
    </h1>
    <p class="description">
      You can enjoy it solo — or bring a friend along to join your chapter
    </p>
    <img class="picture" src={boardGames.src} alt="" />
    <div class="buttons">
      <button class="button button--back">Another Activity</button>
      <a href="/5" class="button">Accept</a>
    </div>
  </body>
</html>

