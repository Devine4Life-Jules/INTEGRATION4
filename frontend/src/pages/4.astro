---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import WebFooter from "../components/WebFooter.astro";
import  boardGames from "../assets/images/boardGames.png"
---

<style>
  body {
    background-color: var(--yellow);
  }

  @media screen and (min-width:100px) {
    body {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }


    header {
      margin-bottom: auto;
      padding: 1rem;

    }
    
  }

  @media screen and (min-width:500px) {
        body {
          display: grid;
          grid-template-rows: auto auto auto 7rem;
          grid-template-columns: 2fr 3fr;
          height: 100vh;
        }

        h1 {
          font-size: 4rem;
          line-height: 1.3 ;
          margin-bottom: auto;
        }

        .wePicked {
          font-size: 1.7rem;
        }

        header {
          height: 100%;
          grid-column:2;
          grid-row: 1 / 4;
          display: flex;
          flex-direction: column;
          

          

        }

 


        figure {
          grid-column:1 ;
          grid-row: 1 / 4;
          align-self: end;
          height: 100%;
        
        }

          figure img {
            object-fit: fill;
            height: 100%;
          }

        header {
          grid-column: 2;
        }

       
        
  }

</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    

      <header>
        <span class="wePicked">We've picked a fun activity for you!</span>
            <h1>
        
        <span class="blueBg">Play board games</span>
        <span class="location">in our living room</span>
            </h1>
            <p>You can enjoy it solo — or bring a friend along to join your chapter</p>
      </header>
    <figure>
      <img src={boardGames.src} alt="">
    </figure>
    <WebFooter>
      <div slot="buttons" class="footerButtons">
       
        <a href="/4" class="footerBtn--secondary">Another Activity</a>
        <a href="/5" class="footerBtn">Accept</a>
      </div>

    </WebFooter>
  </body>
</html>

<script>
  import {gsap, Power1} from "gsap";
  const tl = gsap.timeline();
  const tlDuration = .4;

  tl.from(".wePicked",{
    opacity:0,
    x:-50,
    duration:tlDuration,
    ease:Power1.easeOut
  })
  .from(".blueBg",{
    opacity:0,
    x:-50,
    duration:tlDuration,
    ease:Power1.easeOut
  })
    .from(".location",{
    opacity:0,
    x:-50,
    duration:tlDuration,
    ease:Power1.easeOut
  })
    .from("p",{
    opacity:0,
    x:-50,
    duration:tlDuration,
    ease:Power1.easeOut
  })
</script>
