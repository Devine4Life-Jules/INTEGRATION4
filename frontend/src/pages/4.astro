---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import WebFooter from "../components/WebFooter.astro";

import boardGames from "../assets/images/boardGames.png";
import frisbee from "../assets/images/abbyInside.png";
import cafe from "../assets/images/bringFriend.png";
import drawing from "../assets/images/painter.png";
---

<style>
  body {
    background-color: var(--yellow);
  }

  .hidden {
    display: none;
  }

  .active {
    display: block;
  }

  figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (min-width: 100px) {
    body {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }

    header {
      margin-bottom: auto;
      padding: 1rem;
    }
  }

  @media screen and (min-width: 500px) {
    body {
      display: grid;
      grid-template-rows: auto auto auto 7rem;
      grid-template-columns: 2fr 3fr;
      height: 100vh;
    }

    h1 {
      font-size: 4rem;
      line-height: 1.3;
      margin-bottom: auto;
    }

    .wePicked {
      font-size: 1.7rem;
    }

    header {
      height: 100%;
      grid-column: 2;
      grid-row: 1 / 4;
      display: flex;
      flex-direction: column;
    }

    figure {
      grid-column: 1;
      grid-row: 1 / 4;
      align-self: end;
      height: 100%;
    }

    header {
      grid-column: 2;
    }
  }
</style>

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <header>
      <span class="wePicked">We've picked a fun activity for you!</span>
      <h1>
        <span class="blueBg name">Play board games</span>
        <span class="location">in our living room</span>
      </h1>
      <p>You can enjoy it solo — or bring a friend along to join your chapter</p>
    </header>

    <figure>
      <img class="activity-img active" id="img-boardgames" src={boardGames.src} alt="Play Boardgames" />
      <img class="activity-img hidden" id="img-frisbee" src={frisbee.src} alt="Play frisbee" />
      <img class="activity-img hidden" id="img-cafe" src={cafe.src} alt="Make a drink" />
      <img class="activity-img hidden" id="img-drawing" src={drawing.src} alt="Drawing session" />
    </figure>

    <WebFooter>
      <div slot="buttons" class="footerButtons">
        <button id="anotherBtn" class="footerBtn--secondary">Another Activity</button>
        <a href="/5" class="footerBtn">Accept</a>
      </div>
    </WebFooter>

    <script>
      const activities = [
        {
          name: "Play Boardgames",
          location: "salon",
          imgId: "img-boardgames"
        },
        {
          name: "Play frisbee",
          location: "garden",
          imgId: "img-frisbee"
        },
        {
          name: "Make a drink",
          location: "café",
          imgId: "img-cafe"
        },
        {
          name: "Drawing session",
          location: "atelier",
          imgId: "img-drawing"
        }
      ];

      let currentImgId = "img-boardgames";

      const getRandomActivity = () => {
        let next;
        do {
          next = activities[Math.floor(Math.random() * activities.length)];
        } while (next.imgId === currentImgId);
        return next;
      };

      const updateActivity = () => {
        const activity = getRandomActivity();

        document.querySelector(".blueBg.name").textContent = activity.name;
        document.querySelector(".location").textContent = "in our " + activity.location;

        document.getElementById(currentImgId).classList.remove("active");
        document.getElementById(currentImgId).classList.add("hidden");

        document.getElementById(activity.imgId).classList.add("active");
        document.getElementById(activity.imgId).classList.remove("hidden");

        currentImgId = activity.imgId;
      };

      document.getElementById("anotherBtn").addEventListener("click", updateActivity);
    </script>
  </body>
</html>
