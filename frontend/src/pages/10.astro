---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
  }

  .logo {
    padding: var(--screen-padding);
    padding-bottom: 1em;
  }

  .title {
    padding-bottom: 0;
    line-height: 1.2;
  }

  .description {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .map {
    width: 100%;
  }

  .logo,
  .title {
    background-color: var(--yellow);
  }

  .buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--screen-padding);
  }

  @media screen and (min-width: 500px) {
    .logoWrapper,
    h1 {
      background-color: var(--white);
    }

    .how {
      display: block;
      font-weight: 200;
      font-size: 2rem;
    }

    .logoWrapper {
      grid-column: 2;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
      justify-content: flex-end;
      margin-left: auto;
    }

    h1 {
      grid-column: 2;
      grid-row: 1;
      font-size: 4rem;
      max-width: 60%;
      line-height: 1;
      margin-left: 2rem;
      margin-top: 2rem;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 25vh auto auto 15vh;
      height: 100vh;
    }

    p {
      margin-top: auto;
      max-height: 5rem;
      align-self: flex-end;
      padding-left: 2rem;
      padding-bottom: 2rem;

      text-align: left;
    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .iframeContainer {
      grid-column: 1;
      grid-row: 1 / 4;
      z-index: 1;
    }

    .locationLabel {
      position: relative;
      width: 5rem;
      height: 2rem;
      display: inline-flex;
      align-items: center;
      top: 0;
      left: 0;
      margin-left: 2rem;
    }

    .locationLabel img {
      width: 3rem;
    }

    .locationLabel span {
      font-size: inherit;
      font-weight: bold;
      line-height: 1;
    }

    footer {
      grid-column: 1 / 3;
      background-color: var(--yellow);
      align-items: center;
      flex-direction: row;
    }

    .footerBtn {
      margin-left: auto;
    }

    .iframeContainer iframe {
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .whenever {
      font-size: 1.5rem;
      display: block;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <h1 class="title">Now you know how it works</h1>
    <p class="description">
      <span class="bold">Visit Abby whenever you’d like.</span> We’re looking forward
      to seeing what you’ll share.
    </p>
    <iframe
      class="map"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2520.0948520386924!2d3.2670543133349703!3d50.829406971548806!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c33bdfbfa9a1f5%3A0xd60955fa51b1a1b9!2sAbby%20Kortrijk!5e0!3m2!1sen!2sbe!4v1749760662309!5m2!1sen!2sbe"
      width="600"
      height="400"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="buttons">
      <a class="button button--back" href="/9">Back</a>
      <a class="button buttons__invite" href="/11">Invite a friend</a>
      <a class="button" href={"/story?back=" + encodeURI("/10")}
        >Our Shared Story</a
      >
    </div>
  </body>
</html>
