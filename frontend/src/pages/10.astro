---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import ContinuationProgress from "../components/ContinuationProgress.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img src={AbbyLogoSvg.src} alt="Abby logo" />
    <h1>Know you know how it works!</h1>
    <p>We can’t wait to see what you’ll bring into Abby.</p>
    <p class="bold">Come by whenever you want</p>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2520.0948520386924!2d3.2670543133349703!3d50.829406971548806!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c33bdfbfa9a1f5%3A0xd60955fa51b1a1b9!2sAbby%20Kortrijk!5e0!3m2!1sen!2sbe!4v1749760662309!5m2!1sen!2sbe"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="buttons">
      <a href="./11">Invite a friend</a>
      <a href="/story">Our Shared Story</a>
      <a href="./7">Back</a>
    </div>
  </body>
</html>
