---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
  }

  .logo {
    padding: var(--screen-padding);
    padding-bottom: 1em;
  }

  .title {
    padding-bottom: 0;
    line-height: 1.2;
  }

  .description {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .map {
    width: 100%;
  }

  .logo,
  .title {
    background-color: var(--yellow);
  }

  .buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    padding: var(--screen-padding);
  }

  .buttons__invite {
    background-color: var(--blue);
  }

  @media (orientation: landscape) {
    body {
      grid-template-columns: auto minmax(15rem, 40rem);
      grid-template-rows: auto 1fr max-content;
    }

    .title {
      background: none;
    }

    .logo {
      display: none;
    }

    .title {
      grid-column: 2/3;
      grid-row: 1/2;
      font-size: 4rem;
      line-height: 1.1;
      margin: var(--screen-padding);
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .description {
      margin-top: auto;
      align-self: flex-end;
      background: none;
      font-size: 1.25rem;
      max-width: 30rem;
    }

    .map {
      width: 100%;
      height: 100%;
      grid-row: 1/3;
    }

    .buttons {
      grid-column: 1 / 3;
      grid-row: 3/4;
      background-color: var(--yellow);
      align-items: center;
      flex-direction: row;
      justify-content: space-between;
    }

    .buttons__invite {
      margin-right: auto;
      justify-self: flex-end;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <h1 class="title">
      <span class="title__highlight">Now you know</span> how it works
    </h1>
    <p class="description">
      <span class="bold">Visit Abby whenever you’d like.</span> We’re looking forward
      to seeing what you’ll share.
    </p>
    <iframe
      class="map"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2520.0948520386924!2d3.2670543133349703!3d50.829406971548806!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c33bdfbfa9a1f5%3A0xd60955fa51b1a1b9!2sAbby%20Kortrijk!5e0!3m2!1sen!2sbe!4v1749760662309!5m2!1sen!2sbe"
      width="600"
      height="400"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
    <div class="buttons">
      <a class="button button--back" href="/9">Back</a>
      <a class="button buttons__invite" href="/11">Invite a friend</a>
      <a class="button" href={"/story?back=" + encodeURI("/10")}
        >Our Shared Story</a
      >
    </div>
  </body>
</html>
