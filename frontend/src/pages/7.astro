---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import ContinuationProgress from "../components/ContinuationProgress.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img src={AbbyLogoSvg.src} alt="Abby logo" />
    <h1>Make your activity part of the story</h1>
    <div>
      <!-- !TODO <Image /> -->
      <div>
        <span>Your Activity:</span>
        <span>Boardgames</span>
      </div>
      <div>
        <span>Location:</span>
        <span>Abby's Living Room</span>
      </div>
    </div>
    <ContinuationProgress />
    <p>
      <span class="bold">Whenever you’re ready,</span> just drop by the Salon in
      the museum. That’s where your story will come to life.
    </p>
    <div class="buttons">
      <a href="./6">Back</a>
      <a href="./8">Next</a>
    </div>
  </body>
</html>
