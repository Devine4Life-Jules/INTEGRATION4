---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyInside from "../assets/images/abbyInside.png";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto auto auto 1fr max-content;
    grid-template-columns: 1fr;
    height: 100vh;
  }

  body > * {
    grid-column: 1/2;
  }

  .activity,
  .logo,
  .title {
    background-color: var(--yellow);
  }

  .logo {
    padding: var(--screen-padding) var(--screen-padding) 0 var(--screen-padding);
    padding-bottom: 1em;
  }

  .title {
    line-height: 1.1;
  }

  .activity {
    grid-row: 3/4;
  }

  .location {
    grid-row: 3/4;
  }

  .picture {
    grid-row: 3/4;
  }

  .chapter {
    display: none;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container__p {
    padding-top: 0.2em;
  }

  @media (orientation: landscape) {
    .logoWrapper,
    h1 {
      background-color: var(--white);
    }

    .activityBox {
      position: relative;
      background-color: var(--white);
      display: flex;
    }

    .activityBox div {
      margin-left: 2rem;
    }

    .location {
      background-color: var(--yellow);
      height: 1.3rem;
      width: 5rem;
      text-align: center;
    }

    .how {
      display: block;
      font-weight: 200;
      font-size: 2rem;
    }

    .logoWrapper {
      grid-column: 1;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
    }

    h1 {
      grid-column: 2;
      grid-row: 1;
      font-size: 4rem;
      max-width: 60%;
      line-height: 1;
      margin-left: 2rem;
      margin-top: 2rem;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 25vh auto auto 15vh;
      height: 100vh;
    }

    p {
      grid-column: 2;
      grid-row: 3;
      margin-top: auto;
      max-height: 5rem;
      align-self: flex-start;
      padding-left: 2rem;
      padding-bottom: 7rem;
      text-align: left;
    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    figure {
      grid-column: 1;
      grid-row: 1 / 4;
      z-index: 1;
      height: 100%;
      overflow: hidden;
    }

    .locationLabel img {
      width: 3rem;
    }

    .locationLabel span {
      font-size: inherit;
      font-weight: bold;
      line-height: 1;
    }

    .progressBarWrapper {
      grid-column: 1 / 3;
      background-color: var(--yellow);
    }

    .whenever {
      font-size: 1.5rem;
      display: block;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <span class="chapter">How it works</span>
    <h1 class="title">
      <span class="highlight">Make</span> your activity part of the story
    </h1>
    <div class="activity">
      <span class="activity__text-small">Your activity:</span>
      <span class="activity__text-big">Your activity:</span>
    </div>
    <div class="location">
      <span class="location__text-small">Your activity:</span>
      <span class="location__text-big">Your activity:</span>
    </div>
    <img class="picture" src={AbbyInside.src} alt="Photo of Abby inside" />
    <div class="text-container">
      <h2 class="text-container__title">This is your moment</h2>
      <p class="text-container__p">
        By doing this, you’re shaping your chapter. Whether you’re alone or with
        a friend, <span class="bold"
          >what you create becomes part of your story at Abby.</span
        >
      </p>
    </div>
    <ProgressBar currentStep={2} backLink="/6" nextLink="/8" />
  </body>
</html>
