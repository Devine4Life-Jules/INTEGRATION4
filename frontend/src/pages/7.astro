---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyInside from "../assets/images/abbyInside.png"
---

<style>

  



  .activity {
    display: inline-flex;
    background-color: var(--yellow);

  }

  body {
    background-color: var(--white);
  }

  @media screen and (min-width: 100px) {



    .logoWrapper, h1 {
      background-color: var(--yellow);
      
    }

    body {
      display: grid;
      grid-template-rows: 5vh 15vh auto 20vh;
      height: 100vh;
    }


    .activity {
      position:absolute;
      padding-right: 1rem;
      top:23%;
      left: 3%;
    }

    p {
      text-align: center;
    }

    .how {
      display: none;
    }
    
  }


  @media screen and (min-width: 500px) {

    .logoWrapper, h1 {
      background-color: var(--white);
      
    }

    .how {
      display: block;
      font-weight: 200;
      font-size: 2rem;
    }

    .logoWrapper {
      grid-column: 1;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
    }

    h1 {
      grid-column: 2;
      grid-row: 1;
      font-size: 4rem;
      max-width: 60%;
      line-height: 1;
      margin-left: 2rem;
      margin-top: 2rem;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 25vh auto auto 15vh;
      height: 100vh;
      
      

    }

    p {
      grid-column: 2;
      grid-row: 3;
      margin-top: auto;
      max-height: 5rem;
      align-self: flex-start;
      padding-left: 2rem;
      padding-bottom: 7rem;
      text-align: left;
    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    figure {
      grid-column: 1;
      grid-row: 1 / 4;
      z-index: 1;
      height: 100%;
      overflow: hidden;
    }



    .locationLabel img {
      width: 3rem;
    }

    .locationLabel span {
      font-size: inherit;
      font-weight: bold;
      line-height: 1;
    }

    .progressBarWrapper {
      grid-column: 1 / 3;
      background-color: var(--yellow);
      
      
    }

   

    .whenever {
      font-size: 1.5rem;
      display: block;
    }

  }



</style>


<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logoWrapper"><img src={AbbyLogoSvg.src} alt="Abby logo" /></div>
    <h1>
      Make your activity part of the story
    </h1>
    <div class="activity">
      <img src={LocationSvg.src} alt="Location icon" />
      <span>ABBY</span>
    </div>
    <figure>
      <img src={AbbyInside.src} alt="">
    </figure>
    <p>
      <span class="whenever">This is your moment</span>By doing this activity, you’re shaping your personal chapter. Whether you’re alone or with a friend, what you create becomes part of your story at Abby.
    </p>
    <div class="progressBarWrapper">
      <ProgressBar currentStep={2} backLink="/6" nextLink="/8" ></ProgressBar>
    </div>
  </body>
</html>
