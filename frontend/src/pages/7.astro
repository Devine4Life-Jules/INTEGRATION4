---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyInside from "../assets/images/abbyInside.png";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto auto auto 1fr max-content;
    grid-template-columns: 1fr;
    height: 100vh;
  }

  body > * {
    grid-column: 1/2;
  }

  .activity,
  .logo,
  .title {
    background-color: var(--yellow);
  }

  .logo {
    padding: var(--screen-padding) var(--screen-padding) 0 var(--screen-padding);
    padding-bottom: 1em;
  }

  .title {
    line-height: 1.1;
  }

  .activity {
    grid-row: 3/4;
  }

  .location {
    grid-row: 3/4;
  }

  .picture {
    grid-row: 3/4;
  }

  .chapter {
    display: none;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container__p {
    padding-top: 0.2em;
  }

  @media (orientation: landscape) {
    body {
      grid-template-columns: auto min-content auto;
    }

    .logo,
    .title {
      background-color: var(--white);
    }

    .location {
      background-color: none;
    }

    .chapter {
      display: initial;
      grid-row: 1/2;
      grid-column: 2/4;
      font-size: 2.25rem;
      padding: var(--screen-padding);
      padding-bottom: 0;
    }

    .logo {
      grid-column: 1/2;
      grid-row: 1/2;
      z-index: 100;
      padding: var(--screen-padding);
      background: none;
    }

    .title {
      grid-column: 2/4;
      grid-row: 2/3;
      font-size: 4rem;
      line-height: 1;
      padding: 0 var(--screen-padding);
      margin-bottom: 0.5em;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .activity,
    .location {
      font-size: 1.25rem;
      background: none;
    }

    .activity__text-big,
    .location__text-big {
      font-size: 1.5rem;
      background-color: var(--yellow);
      font-weight: 500;
    }

    .activity {
      grid-row: 3/4;
      grid-column: 2/3;
      margin-left: var(--screen-padding);
      white-space: nowrap;
      margin-right: 1.5em;
    }

    .location {
      grid-row: 3/4;
      grid-column: 3/4;
    }

    .text-container {
      grid-row: 4/5;
      grid-column: 2/4;
      margin-top: auto;
      align-self: flex-end;
      text-align: left;
      max-width: 48rem;
    }

    .text-container__title {
      font-size: 1.5rem;
    }

    .text-container__p {
      font-size: 1rem;
    }

    .picture {
      /* width: 100%;
      height: 100%; */
      height: 100%;
      object-fit: cover;
      grid-column: 1/2;
      grid-row: 1 / 5;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <span class="chapter">How it works</span>
    <h1 class="title">
      <span class="title__highlight">Make</span> your activity part of the story
    </h1>
    <div class="activity">
      <span class="activity__text-small">Your activity:</span>
      <span class="activity__text-big">Boardgames</span>
    </div>
    <div class="location">
      <span class="location__text-small">Your activity:</span>
      <span class="location__text-big">Abby's living room</span>
    </div>
    <img class="picture" src={AbbyInside.src} alt="Photo of Abby inside" />
    <div class="text-container">
      <h2 class="text-container__title">This is your moment</h2>
      <p class="text-container__p">
        By doing this, you’re shaping your chapter. Whether you’re alone or with
        a friend, <span class="bold"
          >what you create becomes part of your story at Abby.</span
        >
      </p>
    </div>
    <ProgressBar
      style="grid-column: 1/4;"
      currentStep={2}
      backLink="/6"
      nextLink="/8"
    />
  </body>
</html>
