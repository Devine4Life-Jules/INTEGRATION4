---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { ClientRouter } from "astro:transitions";
import abbySvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    background: var(--white);
    font-size: 1.25rem;
    display: grid;
    grid-template-rows: auto 3fr auto 1fr;
    min-height: 100vh;
  }

  .container {
    background-color: var(--blue);
    display: grid;
    grid-template-rows: auto auto 1fr;
    padding: var(--screen-padding);
  }

  .container__logo {
    justify-self: end;
    width: 6.688rem;
  }

  .container__title {
    font-weight: 700;
    line-height: 1.2;
    margin-block-end: 1em;
    margin-top: 1em;
  }

  .container__title__start {
    font-weight: 300;
  }

  .container__title__question-mark {
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  }

  .container__location {
    background-color: var(--yellow);
    display: flex;
    align-items: center;
    font-size: 1.625rem;
    width: max-content;
    padding: 0.35rem 0.8rem 0.35rem 0.4rem;
    align-self: end;
    height: max-content;
  }

  .container__location__icon {
    height: 1.5rem;
  }

  .paragraph {
    text-align: center;
    margin: var(--screen-padding);
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    margin: var(--screen-padding);
    align-self: flex-end;
  }

  .buttons__button {
    background-color: var(--green);
    color: var(--black);
    text-decoration: none;
    padding: 1rem;
    font-weight: 500;
    height: min-content;
  }

  .buttons__button--back {
    border: 0.1875rem solid var(--green);
    background: none;
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img class="container__logo" src={abbySvg.src} alt="Abby logo" />
    <h1 class="container__title">
      Hey,
      <span>ready to begin</span> your journey<span
        class="container__title__question-mark">?</span
      >
    </h1>
    <p class="paragraph">
      You’re not just a visitor,
      <span class="bold">you’re starting a chapter in ABBY.</span>
      This is just a short guide, your story starts after.
    </p>
    <div class="buttons">
      <!-- !TODO hide back link -->
      <a class="buttons__button buttons__button--back" href="./4">Back</a>
      <a class="buttons__button" href="./2">Show me how it works</a>
    </div>
  </body>
</html>
