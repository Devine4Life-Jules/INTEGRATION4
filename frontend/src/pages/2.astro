---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbySmilePng from "../assets/icons/abby-smile-black.png";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
import Tape from "../components/Tape.astro";
import PolaroidStack from "../components/PolaroidStack.astro";
---

<style>
  body {
    height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-items: center;
  }
  .container {
    background-color: var(--blue);
    height: 100%;
    display: flex;
    justify-content: center;
    flex-direction: column;
  }

  .title {
    font-size: 3.125rem;
    line-height: 0.8;
    white-space: nowrap;
    margin-top: 0.2em;
  }

  .title__img {
    display: inline;
    width: 3.5rem;
  }

  .title__smaller-text {
    font-size: 1.875rem;
    font-weight: 400;
  }

  .logo {
    align-self: flex-end;
    padding: var(--screen-padding);
    font-variant:;
  }

  @media (orientation: landscape) {
    body {
      flex-direction: column;
      height: 100vh;
    }

    h1 {
      font-size: 5rem;
      margin-top: 5rem;
      margin-left: 6rem;
      line-height: 1;
    }

    .headerBold {
      padding-bottom: 0;
    }

    body {
      height: 100vh;
    }

    .smiley {
      width: 7vw;
    }

    .pageWrapper {
      display: flex;
      flex-direction: row-reverse;
      margin-bottom: auto;
      align-items: block-end;
      padding-bottom: 8rem;
      padding-left: 17rem;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Tape text="you are the key" />
    <div class="container">
      <h1 class="title">
        Good job <img
          class="title__img"
          src={AbbySmilePng.src}
          alt="Abby smile icon"
        /><br />
        <span class="title__smaller-text">Story Unlocked</span>
      </h1>
      <PolaroidStack />
    </div>
    <div class="logo">
      <img class="logo__img" src={AbbyKortrijkSvg.src} alt="Abby icon" />
    </div>
  </body>

  <script>
    import { navigate } from "astro:transitions/client";
    // setTimeout(() => navigate("/3"), 4000);
  </script>
</html>
