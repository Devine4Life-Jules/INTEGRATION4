---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Tape from "../components/Tape.astro";
import keyholeBlackSvg from "../assets/illustrations/keyholeBlack.svg";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    background-color: var(--white);
    height: 100vh;
    display: grid;
    grid-template-rows: auto auto auto auto 1fr;
  }

  .fade {
    animation: fadeLoop 3s infinite ease-in-out;
  }

  @keyframes fadeLoop {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .lock {
    background-color: var(--blue);
    padding: var(--screen-padding);
  }

  .lock__container {
    margin: auto;
    width: 12vh;
    display: grid;
    justify-items: center;
    position: relative;
  }

  .lock__instruction {
    text-align: center;
    padding-bottom: 2em;
  }

  .lock__img {
    grid-column: 1/2;
    grid-row: 1/2;
    width: 100%;
  }

  .lock__key {
    position: absolute;
    top: 22%;
    grid-column: 1/2;
    grid-row: 1/2;
    background: var(--yellow);
    z-index: 100;
    width: 80%;
    height: 10%;
  }

  .title {
    font-size: 2rem;
    background-color: var(--blue);
    padding: var(--screen-padding);
    padding-top: 1em;
    text-align: center;
    line-height: 1.2;
  }

  .title__bottom {
    font-weight: 400;
  }

  .description {
    margin-top: 1.4em;
    padding: var(--screen-padding);
  }

  .logo {
    align-self: flex-end;
    margin: var(--screen-padding);
  }

  @media (orientation: landscape) {
    body {
      display: grid;
      grid-template-rows: auto auto 1fr max-content;
      grid-template-columns: 50vw 50vw;
      justify-content: space-around;
      width: 100%;
      gap: 0;
      height: 100vh;
    }

    h1 {
      font-size: 3rem;
      background-color: var(--white);
      margin: 0;
      grid-row: 2;
      background-color: none;
      text-align: left;
    }

    .description {
      grid-row: 3;
      grid-column: 1;
    }

    .lock {
      grid-row: 2 / 4;
      z-index: 300000;
      width: 100%;
      min-width: none;
      height: 100%;
    }

    .tapeWrapper {
      grid-row: 1;
      grid-column-start: span 2;
      z-index: 1;
      padding: 0;
      margin: 0;
      background-color: var(--green);
      height: 100%;
      padding-top: 0.5rem;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Tape class={"tape"} text="you are the key" />
    <h1 class="title">
      <span class="title__top">
        <span class="title__highlight">You are </span>the key
      </span><br />
      <span class="title__bottom">to our story</span>
    </h1>
  </body>
  <div class="lock">
    <div class="lock__container">
      <img
        class="lock__img"
        src={keyholeBlackSvg.src}
        alt="icon of a keyhole"
      />
      <div class="lock__key"></div>
    </div>
    <p class="lock__instruction fade">click and the key hold to unlock</p>
  </div>
  <div class="description">
    <h2>Dare to try?</h2>
    <p>
      Find out what will happen after unlocking our story, you are the key - we
      need you.
    </p>
  </div>
  <img class="logo" src={AbbyKortrijkSvg.src} alt="Abby icon" />
</html>

