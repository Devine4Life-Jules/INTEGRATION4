---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Tape from "../components/Tape.astro";
import keyholeBlackSvg from "../assets/illustrations/keyholeBlack.svg";
import AbbyKortrijkSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    background-color: var(--white);
    height: 100vh;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    grid-template-columns: 1fr 1fr;
  }

  body > * {
    grid-column: 1/3;
  }

  .fade {
    animation: fadeLoop 3s infinite ease-in-out;
  }

  @keyframes fadeLoop {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .lock {
    background-color: var(--blue);
    padding: var(--screen-padding);
  }

  .lock__container {
    margin: auto;
    width: 12vh;
    display: grid;
    justify-items: center;
    position: relative;
  }

  .lock__instruction {
    text-align: center;
    padding-top: 0.7em;
    padding-bottom: 2em;
  }

  .lock__img {
    width: 100%;
  }

  .lock__key {
    position: absolute;
    top: 22%;
    background: var(--yellow);
    z-index: 100;
    width: 80%;
    height: 10%;
  }

  .title {
    font-size: 2rem;
    background-color: var(--blue);
    padding: var(--screen-padding);
    padding-top: 1em;
    text-align: center;
    line-height: 1.2;
  }

  .title__bottom {
    font-weight: 400;
  }

  .description {
    margin-top: 1.4em;
    font-size: 2;
    padding: var(--screen-padding);
  }

  .logo {
    align-self: flex-end;
    padding: var(--screen-padding);
  }

  @media (orientation: landscape) {
    body {
      display: grid;
      grid-template-rows: auto auto 1fr max-content;
      grid-template-columns: auto auto;
      justify-content: space-around;
      height: 100vh;
    }

    .title {
      font-size: 5rem;
      line-height: 1;
      grid-row: 2/3;
      background: none;
      text-align: left;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .description {
      grid-row: 3/4;
      grid-column: 1/2;
      margin-top: 0;
      align-self: flex-end;
    }

    .description__title {
      font-size: 2.5rem;
      font-weight: 500;
    }

    .description__p {
      font-size: 1.563rem;
      max-width: 30rem;
    }

    .lock {
      grid-row: 2 / 4;
      grid-column: 2/3;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .lock__container {
      width: 20vh;
      margin-top: 8em;
      margin-bottom: 1em;
    }

    .lock__instruction {
      font-size: 2.5rem;
      max-width: 20rem;
      margin: 0 auto;
      line-height: 1.2;
    }

    .logo {
      grid-row: 4/5;
      background-color: var(--yellow);
      grid-column: 1/3;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Tape style="grid-column:1/3;" text="you are the key" />
    <h1 class="title">
      <span class="title__top">
        <span class="title__highlight">You are</span> the key
      </span><br />
      <span class="title__bottom">to our story</span>
    </h1>
  </body>
  <div class="lock">
    <div class="lock__container">
      <img
        class="lock__img"
        src={keyholeBlackSvg.src}
        alt="icon of a keyhole"
      />
      <div class="lock__key"></div>
    </div>
    <p class="lock__instruction fade">click and the key hold to unlock</p>
  </div>
  <div class="description">
    <h2 class="description__title">Dare to try?</h2>
    <p class="description__p">
      Find out what will happen after unlocking our story, you are the key - we
      need you.
    </p>
  </div>
  <div class="logo">
    <img class="logo__img" src={AbbyKortrijkSvg.src} alt="Abby icon" />
  </div>
</html>

