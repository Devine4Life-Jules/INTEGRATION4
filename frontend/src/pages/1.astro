---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Tape from "../components/Tape.astro";
import AbbySvg from "../assets/illustrations/abby-kortrijk.svg";
import keyHoleBlack from "../assets/illustrations/keyholeBlack.svg";
import WebFooter from "../components/WebFooter.astro";
---

<style>
  body {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: var(--white);

  }

      .fade {
        animation: fadeLoop 3s infinite ease-in-out;

    }

    @keyframes fadeLoop {
    0% { opacity: 0; }
    50% { opacity: 1; }
    100% { opacity: 0; }
  }

  .key {
    width: 12vh;
    height: 5vh;
    background: var(--yellow);
    // margin: 16vh auto;
  }

  @media screen and (min-width: 100px){
    h1 {
      font-size: 2rem;
      background-color: var(--blue);
      padding-top: 2rem;
      padding-left:1rem;
    }



    .lock {
      background-color: var(--blue);
      width: 100vw;
      min-height: 55vh;
      background-repeat: no-repeat;
      background-position: center 10vh;
      background-size: 30%;
      display: flex;
      flex-direction: column; 
      align-items: center;    
      justify-content: center; 
      position: relative;

      
    }

    .key {
      justify-content: flex-start;
      margin-top: 15vh;
    }

    .holdInstruction{
      margin-top: 25vh;
      text-align: center;
      padding-bottom: 3rem;
      background-color: var(--blue);
    }

    .description {
      padding: 1.5rem;
    }

    .titleLight {
      font-weight: 400;
    }



    
  }

    @media screen and (min-width: 500px){



      body {
        display: grid;
        grid-template-rows: 5vh 42vh 42vh auto;
        grid-template-columns: 50vw 50vw;
        justify-content: space-around;
        width: 100%;
        gap: 0;
        height: 100vh;
      }

    h1 {
      font-size: 3rem;
      background-color: var(--white);
      margin: 0;
      grid-row: 2;
      background-color: none;
    }

    .description {
      grid-row: 3;
      grid-column: 1;
    }

    .lock {
      grid-row: 2 / 4; ;
      z-index: 300000;
      width: 100%;
      min-width: none;
      height: 100%;

    }



    .tapeWrapper {
      grid-row: 1;
      grid-column-start: span 2;
      z-index: 1;
      padding: 0;
      margin: 0;
      background-color: var(--green);
      height: 100%;
      padding-top:.5rem;
      
      
      
    }


    
  }


</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="tapeWrapper">
      <Tape text="you are the key" />
    </div>
    <h1 class=""><span class="headerBold">You are the key </span><br /> <span class="titleLight">to our story</span> </h1>
    <div class="lock" style={`background-image: url(${keyHoleBlack.src})`}>
      <div id="key" class="key"></div>
      <p class="holdInstruction fade">click and the key hold to unlock</p>
    </div>
    <div class="description">
      <h2>Dare to try?</h2>
      <p>
        Find out what will happen after unlocking our story, you are the key -
        we need you.
      </p>
    </div>
    <WebFooter mobileBgColor="white" desktopBgColor="yellow"></WebFooter>

  </body>
</html>

<script>
  import { navigate } from "astro:transitions/client";
  import { gsap, Power1 } from "gsap";

  const mm = gsap.matchMedia();

  const tl = gsap.timeline();
  tl
      const tlDuration = .4
  

  mm.add("(min-width: 500px)", () => {
    const tl = gsap.timeline();

    tl
    
    .from("footer",{
    y:300,
    duration: tlDuration,
  })

    .from(".lock", {
      x: 600,
      opacity: 0,
      duration: tlDuration,
      ease: Power1.easeOut,
    })
    .from("h1, .description", {
      opacity: 0,
      x:-300,
      duration: tlDuration
    })


  });

  

  mm.add("(min-width: 100px) and (max-width: 499px)", () => {
    const tl = gsap.timeline();

    
    tl
    .from(".headerBold", {
      scale: 0.5,
      opacity: 0,
      duration: 1
    })
    .from(".description", {
      opacity: 0,
      y: 50,
      duration: 1
    });
  });



  gsap

  const $key = document.querySelector("#key") as HTMLDivElement;

  let intervalId: ReturnType<typeof setInterval>;
  let keyRotaion = 0;

  const handleMouseDown = () => {
    intervalId = setInterval(() => {
      keyRotaion++;
      $key.style.transform = `rotate(${keyRotaion}deg)`;

      if (keyRotaion >= 90) {
        clearInterval(intervalId);
        $key.removeEventListener("mousedown", handleMouseDown);
        $key.removeEventListener("touchstart", handleMouseDown);
        window.removeEventListener("mouseup", handleMouseUp);
        window.removeEventListener("touchend", handleMouseUp);
        navigate("/2");
      }
    }, 10);
  };
  const handleMouseUp = () => clearInterval(intervalId);
  $key.addEventListener("mousedown", handleMouseDown);
  window.addEventListener("mouseup", handleMouseUp);
  $key.addEventListener("touchstart", handleMouseDown);
  window.addEventListener("touchend", handleMouseUp);
</script>
