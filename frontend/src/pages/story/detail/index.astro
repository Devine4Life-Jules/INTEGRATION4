---
import ClientRouter from "astro/components/ClientRouter.astro";
import BaseHead from "../../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../../consts";
import AbbySvg from "../../../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    display: grid;
    grid-template-rows: repeat(3, auto) 1fr;
    min-height: 100vh;
  }

  .picture {
    grid-row: 1/2;
    aspect-ratio: 1/1;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .subtitle {
    position: absolute;
    left: var(--screen-padding);
    top: 1em;
    line-height: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .subtitle__first-text {
    background-color: var(--yellow);
    line-height: 1;
    padding: 0.1em;
    font-size: 2.5rem;
  }

  .subtitle__second-text {
    font-weight: 500;
  }

  .title {
    font-size: 3.5rem;
    line-height: 1;
    margin: 0.3em var(--screen-padding) 0.2em var(--screen-padding);
  }

  .description {
    margin: 0 var(--screen-padding);
  }

  .abby-logo {
    display: none;
  }

  .buttons {
    margin: var(--screen-padding);
    display: flex;
    justify-content: space-between;
    align-self: end;
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <h1 class="title"></h1>
    <h2 class="subtitle">
      <span class="subtitle__first-text">Chapter</span>
      <span class="subtitle__second-text"></span>
    </h2>
    <p class="description"></p>
    <img class="abby-logo" src={AbbySvg.src} alt="Abby logo" />
    <img class="picture" alt="Abby activity" />
    <div class="buttons">
      <a class="button button--back" href="../">Back</a>
      <a class="button" href="/upload">Share your chapter</a>
    </div>
  </body>
</html>

<script>
  import { API_URL } from "../../../consts";

  const storyId = new URL(location.href).searchParams.get("id");

  const res = await fetch(
    `${API_URL}/jsonapi/node/story/${storyId}?include=field_picture`
  );
  const data = await res.json();

  type Story = {
    date: string;
    username: string | null;
    description: string | null;
    photoUrl: string;
  };
  const story: Story = {
    date: data.data.attributes.created,
    username: data.data.attributes.field_username,
    description: data.data.attributes.field_description,
    photoUrl: data.included[0].attributes.uri.url,
  };

  const $title = document.querySelector(".title") as HTMLHeadingElement;
  $title.textContent = story.username ? story.username : "Anonymous visitor";

  const getNiceLookinDate = (dateStr: string) => {
    const date = new Date(dateStr);
    return `${date.getDate()}.${date.getMonth()}.${date.getFullYear()}`;
  };

  const $subtitleSecondText = document.querySelector(
    ".subtitle__second-text"
  ) as HTMLSpanElement;
  $subtitleSecondText.textContent = getNiceLookinDate(story.date);

  const $description = document.querySelector(
    ".description"
  ) as HTMLParagraphElement;
  $description.textContent = story.description;

  const $picture = document.querySelector(".picture") as HTMLImageElement;
  $picture.src = API_URL + story.photoUrl;
</script>
