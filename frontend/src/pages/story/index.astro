---
import ClientRouter from "astro/components/ClientRouter.astro";
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import AbbySvg from "../../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    display: grid;
    min-height: 100vh;
    grid-template-rows: repeat(4, auto) 1fr;
    justify-items: center;
  }

  .title {
    font-size: 3.75rem;
    background-color: var(--blue);
    width: max-content;
    margin: 0.8em auto 0.2em;
    font-weight: 700;
    text-transform: capitalize;
    line-height: 1.2;
    padding: 0 0.05em;
  }

  .paragraph {
    font-size: 1.25rem;
    text-align: center;
    max-width: 24rem;
    margin-bottom: 0.8em;
  }

  .search {
    background-color: var(--yellow);
    border: 0.17em solid var(--black);
    font-size: 1.188rem;
    padding: 0.4em 0.8em;
    width: 80%;
    max-width: 22rem;
  }

  .stories__outer {
    overflow-x: scroll;
    max-width: 100vw;
    margin: 1.5em 0 2em 0;
  }

  .stories {
    display: grid;
    gap: 1em;
    grid-template-columns: repeat(14, 1fr);
    grid-template-rows: repeat(2, 1fr);
    width: 700%;
    padding: 1em 5vw;
  }

  .stories__story {
    background-color: var(--white);
    padding: 7%;
    display: block;
    width: 45vw;
    text-decoration: none;
    position: relative;
  }

  .stories__story__img {
    aspect-ratio: 1/1;
    width: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .stories__story__username {
    color: var(--black);
    font-weight: 700;
    background-color: var(--purple);
    width: max-content;
    padding: 0.3em;
    line-height: 1;
    font-size: 1.2rem;
    position: absolute;
    top: -0.5em;
    left: -0.6em;
  }

  .buttons {
    display: flex;
    justify-content: space-between;
    width: 90vw;
    align-items: flex-end;
    margin-bottom: 1.8em;
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img class="hidden" src={AbbySvg.src} alt="Abby logo" />
    <h1 class="title">Our story</h1>
    <p class="paragraph">
      Every image holds a moment —<br />
      <span class="bold">tap to explore</span> the story behind it and see how others
      have added to our story
    </p>
    <input class="search" type="text" placeholder="Search bar" id="search" />
    <div class="stories__outer">
      <div class="stories">
        <a class="stories__story hidden" href="#">
          <figure>
            <img class="stories__story__img" alt="activity photo" />
            <figcaption class="stories__story__username"></figcaption>
          </figure>
        </a>
      </div>
    </div>
    <div class="buttons">
      <a class="button button--back" href="/10">Back</a>
      <a class="button" href="/3">Create your chapter</a>
    </div>
  </body>
</html>

<script>
  import { API_URL } from "../../consts";

  const res = await fetch(
    `${API_URL}/drupal/jsonapi/node/story?include=field_picture`
  );
  const data = await res.json();
  const parsedData = data.data.map((story: any, i: number) => {
    const photo = data.included[i];
    return {
      id: story.id,
      username: story.attributes.field_username,
      photoUrl: photo.attributes.uri.url,
    };
  });

  type Story = {
    id: string;
    username: string | null;
    photoUrl: string;
  };
  const $stories = document.querySelector(".stories") as HTMLDivElement;
  parsedData.forEach((story: Story) => {
    const $storyProt = document.querySelector(
      ".stories__story"
    ) as HTMLAnchorElement;
    const $story = $storyProt.cloneNode(true) as HTMLAnchorElement;
    $story.setAttribute("href", `/story/detail?id=${story.id}`);
    const $storyImg = $story.querySelector(
      ".stories__story__img"
    ) as HTMLImageElement;
    $storyImg.setAttribute("src", API_URL + story.photoUrl);
    const $storyFigcaption = $story.querySelector(
      ".stories__story__username"
    ) as HTMLElement;
    $storyFigcaption.textContent = story.username;
    $story.classList.remove("hidden");

    $stories.append($story);
  });
</script>
