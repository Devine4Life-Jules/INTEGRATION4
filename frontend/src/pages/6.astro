---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyOutside from "../assets/images/abbyOutside.png";
import { Image } from "astro:assets";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    grid-template-columns: 1fr;
    height: 100vh;
  }

  @media (orientation: portrait) {
    body > * {
      grid-column: 1/2;
    }
  }

  .logo,
  .title {
    background-color: var(--yellow);
  }

  .title {
    padding: var(--screen-padding);
    line-height: 1.1;
    padding-top: 0.6em;
  }

  .label {
    display: flex;
    background-color: var(--yellow);
    width: max-content;
    height: max-content;
    align-items: center;
    padding: 0.1em 0.8em 0.1em 0.2em;
    margin: var(--screen-padding);
    grid-row: 3/4;
    z-index: 100;
  }

  .description {
    text-align: center;
    margin: var(--screen-padding);
    display: block;
    height: max-content;
  }

  .picture {
    grid-row: 3/4;
  }

  .chapter {
    display: none;
  }

  .logo {
    padding: var(--screen-padding);
    padding-bottom: 0;
  }

  @media (orientation: landscape) {
    body {
      grid-template-columns: auto auto;
      grid-template-rows: auto auto auto 1fr max-content;
      height: 100vh;
    }

    .logo,
    .title {
      background-color: var(--white);
    }

    .chapter {
      display: block;
      font-weight: 200;
      font-size: 2.5rem;
      padding: var(--screen-padding);
      padding-bottom: 0;
    }

    .logo {
      grid-column: 1/2;
      grid-row: 1/2;
      z-index: 100;
      padding: var(--screen-padding);
      background: none;
    }

    .title {
      grid-column: 2/3;
      grid-row: 2/3;
      font-size: 4rem;
      line-height: 1;
      padding: var(--screen-padding);
      padding-bottom: 0;
      padding-top: 0.2em;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .description {
      align-self: flex-end;
      padding: var(--screen-padding);
      text-align: left;
      grid-row: 4/5;
      grid-column: 2/3;
      margin: 0;
      font-size: 1.3rem;
    }

    .picture {
      width: 100%;
      height: 100%;
      object-fit: cover;
      grid-column: 1;
      grid-row: 1 / 5;
      z-index: 1;
    }

    .label {
      margin-top: 1.3em;
    }

    .label__img {
      width: 2rem;
    }

    .label__text {
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <span class="chapter">How it works</span>
    <h1 class="title">
      <span class="title__highlight">Your story</span> begins inside
    </h1>
    <div class="label">
      <img class="label__img" src={LocationSvg.src} alt="Location icon" />
      <span class="label__text">ABBY</span>
    </div>
    <Image class="picture" src={AbbyOutside} alt="Abby" />
    <p class="description">
      <span class="bold">Whenever you’re ready,</span> just drop by the Salon in
      the museum. That’s where your story will come to life.
    </p>
    <ProgressBar currentStep={1} backLink="/5" nextLink="/7" />
  </body>
</html>
