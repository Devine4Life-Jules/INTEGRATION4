---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyOutside from "../assets/images/abbyOutside.png";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto auto auto 1fr max-content;
    height: 100vh;
  }

  .label {
    display: inline-flex;
    background-color: var(--yellow);
    grid-row: 3/4;
    grid-column: 1/2;
    z-index: 100;
    height: max-content;
    width: max-content;
    align-items: center;
    padding: 0.3em 0.5em 0.3em 0;
    margin: var(--screen-padding);
  }

  .label__img {
    width: 1.5rem;
  }

  .picture {
    grid-row: 3/4;
    grid-column: 1/2;
  }

  .logo,
  .title {
    background-color: var(--yellow);
  }

  .title {
    line-height: 1.2;
    padding-top: 0.6em;
  }

  .logo {
    padding: var(--screen-padding);
  }

  .chapter {
    display: none;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container {
    text-align: center;
  }

  .text-container__p {
    text-align: center;
    padding-top: 0.2em;
  }

  @media (orientation: landscape) {
    body {
      grid-template-rows: auto auto auto 1fr max-content;
      grid-template-columns: auto auto;
    }

    .logo,
    .title {
      background: none;
    }

    .logo {
      position: absolute;
      top: var(--screen-padding);
      left: var(--screen-padding);
      padding: 0;
      z-index: 100;
    }

    .title {
      grid-column: 2/3;
      grid-row: 2/3;
      font-size: 4rem;
      padding: var(--screen-padding);
      padding-bottom: 0.5em;
      padding-top: 0;
      line-height: 1.1;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .text-contaiener {
      padding: var(--screen-padding);
    }

    .text-container__p {
      align-self: flex-end;
      text-align: left;
    }

    .text-container__title {
      text-align: left;
    }

    .picture {
      grid-column: 1/2;
      grid-row: 1 / 5;
      height: 100%;
      object-fit: cover;
    }

    .chapter {
      display: initial;
      padding: var(--screen-padding);
      padding-bottom: 0.2em;
      height: min-content;
      font-size: 2.5rem;
    }

    .label {
      grid-column: 2/3;
      grid-row: 3/4;
      margin-top: 0em;
      font-size: 1.625rem;
    }

    .label__img {
      width: 2rem;
    }

    .text-container {
      align-self: flex-end;
      max-width: 35rem;
    }

    .text-container__title {
      font-size: 2.5rem;
    }

    .text-container__p {
      font-size: 1.6rem;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <span class="chapter">How it works</span>
    <h1 class="title">
      <span class="title__highlight">Your</span> story begins inside
    </h1>
    <div class="label">
      <img class="label__img" src={LocationSvg.src} alt="Location icon" />
      ABBY
    </div>
    <img class="picture" src={AbbyOutside.src} alt="image of Abby" />
    <div class="text-container">
      <h2 class="text-container__title">Whenever you're ready</h2>
      <p class="text-container__p">
        Just drop by the Salon in the museum. That’s where your story will come
        to life.
      </p>
    </div>
    <ProgressBar currentStep={1} backLink="/5" nextLink="/7" />
  </body>
</html>
