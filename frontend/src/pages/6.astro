---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyOutside from "../assets/images/abbyOutside.png"
---

<style>



  .locationLabel {
    display: inline-flex;
    background-color: var(--yellow);

  }

  body {
    background-color: var(--white);
  }

  @media screen and (min-width: 100px) {



    .logoWrapper, h1 {
      background-color: var(--yellow);
      
    }

    body {
      display: grid;
      grid-template-rows: 5vh 15vh auto 20vh;
      height: 100vh;
    }


    .locationLabel {
      position:absolute;
      padding-right: 1rem;
      top:23%;
      left: 3%;
    }

    p {
      text-align: center;
    }
    
  }


  @media screen and (min-width: 500px) {

    .logoWrapper, h1 {
      background-color: var(--white);
      
    }

    .logoWrapper {
      grid-column: 1;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
    }

    h1 {
      grid-column: 2;
      grid-row: 1;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto 10vh;
      height: 100vh;
      
      

    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    figure {
      grid-column: 1;
      grid-row: 1 / 4;
      z-index: 1;
    }

    .locationLabel {
      position: relative;
      width: 5rem;
      height: 1rem;
      display: inline-flex;

    }

    .locationLabel img {
      width: 2rem;
    }

    .locationLabel span {
  font-size: inherit;
  font-weight: bold;
  line-height: 1;
}

.progressBarWrapper {
  grid-column: 1 / 3;
  background-color: var(--yellow);
}

p {
  text-align: left;
}

  }



</style>


<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logoWrapper"><img src={AbbyLogoSvg.src} alt="Abby logo" /></div>
    <h1>Your story begins inside</h1>
    <div class="locationLabel">
      <img src={LocationSvg.src} alt="Location icon" />
      <span>ABBY</span>
    </div>
    <figure>
      <img src={AbbyOutside.src} alt="">
    </figure>
    <p>
      <span class="bold">Whenever you’re ready,</span> just drop by the Salon in
      the museum. That’s where your story will come to life.
    </p>
    <div class="progressBarWrapper">
      <ProgressBar currentStep={1} backLink="/5" nextLink="/7" ></ProgressBar>
    </div>
  </body>
</html>
