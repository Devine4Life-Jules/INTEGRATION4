---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import AbbyOutside from "../assets/images/abbyOutside.png";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto auto auto 1fr max-content;
    height: 100vh;
  }

  .label {
    display: inline-flex;
    background-color: var(--yellow);
    grid-row: 3/4;
    grid-column: 1/2;
    z-index: 100;
    height: max-content;
    width: max-content;
    align-items: center;
    padding: 0.3em 0.5em 0.3em 0;
    margin: var(--screen-padding);
  }

  .label__img {
    width: 1.5rem;
  }

  .picture {
    grid-row: 3/4;
    grid-column: 1/2;
  }

  .logo,
  .title {
    background-color: var(--yellow);
  }

  .title {
    line-height: 1.2;
    padding-top: 0.6em;
  }

  .logo {
    padding: var(--screen-padding);
  }

  .chapter {
    display: none;
  }

  .text-container {
    padding: var(--screen-padding);
  }

  .text-container {
    text-align: center;
  }

  .text-container__p {
    text-align: center;
    padding-top: 0.2em;
  }

  @media (orientation: landscape) {
    .logoWrapper,
    h1 {
      background-color: var(--white);
    }

    .how {
      display: block;
      font-weight: 200;
      font-size: 2rem;
    }

    .logoWrapper {
      grid-column: 1;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
    }

    h1 {
      grid-column: 2;
      grid-row: 1;
      font-size: 4rem;
      max-width: 60%;
      line-height: 1;
      margin-left: 2rem;
      margin-top: 2rem;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 25vh auto auto 15vh;
      height: 100vh;
    }

    p {
      margin-top: autos;
      max-height: 5rem;
      align-self: flex-end;
      padding-left: 2rem;
      padding-bottom: 2rem;
      text-align: left;
    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    figure {
      grid-column: 1;
      grid-row: 1 / 4;
      z-index: 1;
    }

    .locationLabel {
      position: relative;
      width: 5rem;
      height: 2rem;
      display: inline-flex;
      align-items: center;
      top: 0;
      left: 0;
      margin-left: 2rem;
    }

    .locationLabel img {
      width: 3rem;
    }

    .locationLabel span {
      font-size: inherit;
      font-weight: bold;
      line-height: 1;
    }

    .progressBarWrapper {
      grid-column: 1 / 3;
      background-color: var(--yellow);
    }

    .whenever {
      font-size: 1.5rem;
      display: block;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo">
      <img class="logo__img" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <span class="chapter">How it works</span>
    <h1 class="title">
      <span class="title__highlight">Your</span> story begins inside
    </h1>
    <div class="label">
      <img class="label__img" src={LocationSvg.src} alt="Location icon" />
      ABBY
    </div>
    <img class="picture" src={AbbyOutside.src} alt="image of Abby" />
    <div class="text-container">
      <h2 class="text-container__title">Whenever you're ready</h2>
      <p class="text-container__p">
        Just drop by the Salon in the museum. That’s where your story will come
        to life.
      </p>
    </div>
    <ProgressBar currentStep={1} backLink="/5" nextLink="/7" />
  </body>
</html>
