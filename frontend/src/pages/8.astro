---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
import ProgressBar from "../components/ProgressBar.astro";
import painter from "../assets/images/painter.png"
---

<style>

  



  .locationLabel {
    display: inline-flex;
    background-color: var(--yellow);

  }

  body {
    background-color: var(--white);
  }

  @media screen and (min-width: 100px) {



    .logoWrapper, h1 {
      background-color: var(--yellow);
      
    }

    body {
      display: grid;
      grid-template-rows: 8vh 15vh auto 20vh;
      height: 100vh;
    }


    .locationLabel {
      position:absolute;
      padding-right: 1rem;
      top:23%;
      left: 3%;
    }

      figure {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin: 0 auto;
    width: 100%;
  }


  figure img {
   
    height: auto;
    width: 200%;
    object-fit: cover;
    display: block;
  }

    p {
      text-align: center;
    }

    .how {
      display: none;
    }
    
  }


  @media screen and (min-width: 500px) {

    .logoWrapper, h1 {
      background-color: var(--white);
      
    }

    .how {
      display: block;
      font-weight: 200;
      font-size: 2rem;
    }

    .logoWrapper {
      grid-column: 2;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
      justify-content: flex-end;
      margin-left: auto;
    }

    h1 {
      grid-column: 1;
      grid-row: 1;
      font-size: 4rem;
      max-width: 60%;
      line-height: 1;
      margin-left: 2rem;
      margin-top: 2rem;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 25vh auto auto 15vh;
      height: 100vh;
      
      

    }

    p {
      margin-top: autos;
      max-height: 5rem;
      align-self: flex-end;
      padding-left: 2rem;
      padding-bottom: 2rem;
      
      text-align: left;
    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    figure {
      grid-column: 2;
      grid-row: 1 / 4;
      z-index: 1;
      height: 100%;
      overflow: hidden;
    }

    .locationLabel {
      position: relative;
      width: 5rem;
      height: 2rem;
      display: inline-flex;
      align-items: center;
      top: 0;
      left: 0;
      margin-left: 2rem;
      

    }

    .locationLabel img {
      width: 3rem;
    }

    .locationLabel span {
      font-size: inherit;
      font-weight: bold;
      line-height: 1;
    }

    .progressBarWrapper {
      grid-column: 1 / 3;
      background-color: var(--yellow);
      
      
    }

   

    .whenever {
      font-size: 1.5rem;
      display: block;
    }

  }



</style>


<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logoWrapper"><img src={AbbyLogoSvg.src} alt="Abby logo" /></div>
    <h1>
      <span class="oneImage">1 image </span><span class="thousandWords">says more than 1000 words</span>
    </h1>
    <div class="locationLabel">
      <img src={LocationSvg.src} alt="Location icon" />
      <span>ABBY</span>
    </div>
    <figure>
      <img src={painter.src} alt="">
    </figure>
    <p>
      <span class="whenever">Your moments matter to us</span> After your visit, share your pictures - so your chapter becomes part of our story
    </p>
    <div class="progressBarWrapper">
      <ProgressBar currentStep={3} backLink="/7" nextLink="/9" ></ProgressBar>
    </div>
  </body>
</html>


<script>

  const mm = gsap.matchMedia();

  import { gsap, Power1 } from "gsap";
  const tl = gsap.timeline();
  const tlDuraton = .5


mm.add('min-width:500px', () => {
    tl
  .from("figure",{
    x:300,
    opacity:0,
    duration: tlDuraton,
    ease:Power1.easeOut
  })
    .from("h1, p",{
    x:-300,
    opacity:0,
    duration: tlDuraton,
    ease:Power1.easeOut
  })

})


</script>