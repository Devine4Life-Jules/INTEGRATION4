---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import ContinuationProgress from "../components/ContinuationProgress.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import LocationSvg from "../assets/icons/location.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img src={AbbyLogoSvg.src} alt="Abby logo" />
    <h1>1 image says more than 1000 words</h1>
    <div>
      <!-- !TODO <Image /> -->
      <div>
        <span>Snap and Upload Your</span>
        <span>Pictures</span>
      </div>
    </div>
    <ContinuationProgress />
    <p>
      <span class="bold">Your moments matter to us.</span> After your visit, share
      your pictures so your chapter becomes part of our story.
    </p>
    <div class="buttons">
      <a href="./7">Back</a>
      <a href="./9">Next</a>
    </div>
  </body>
</html>
