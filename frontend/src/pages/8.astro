---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import ProgressBar from "../components/ProgressBar.astro";
import UploadJpg from "../assets/images/upload.jpg";
import Image from "astro/components/Image.astro";
---

<style>
  body {
    background-color: var(--white);
    display: grid;
    grid-template-rows: auto auto auto 1fr auto;
    height: 100vh;
  }

  .logo__wrapper,
  .title {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .title {
    line-height: 1.3;
  }

  .label {
    background-color: var(--yellow);
  }

  .picture {
    position: relative;
  }

  .picture__img {
    height: auto;
    object-fit: cover;
    display: block;
  }

  .description {
    text-align: center;
    margin: var(--screen-padding);
  }

  @media screen and (min-width: 500px) {
    .logoWrapper,
    h1 {
      background-color: var(--white);
    }

    .how {
      display: block;
      font-weight: 200;
      font-size: 2rem;
    }

    .logoWrapper {
      grid-column: 2;
      grid-row: 1;
      z-index: 100;
      padding: 1rem;
      background-color: transparent;
      justify-content: flex-end;
      margin-left: auto;
    }

    h1 {
      grid-column: 1;
      grid-row: 1;
      font-size: 4rem;
      max-width: 60%;
      line-height: 1;
      margin-left: 2rem;
      margin-top: 2rem;
    }

    body {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 25vh auto auto 15vh;
      height: 100vh;
    }

    p {
      margin-top: autos;
      max-height: 5rem;
      align-self: flex-end;
      padding-left: 2rem;
      padding-bottom: 2rem;

      text-align: left;
    }

    figure img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    figure {
      grid-column: 2;
      grid-row: 1 / 4;
      z-index: 1;
      height: 100%;
      overflow: hidden;
    }

    .locationLabel {
      position: relative;
      width: 5rem;
      height: 2rem;
      display: inline-flex;
      align-items: center;
      top: 0;
      left: 0;
      margin-left: 2rem;
    }

    .locationLabel img {
      width: 3rem;
    }

    .locationLabel span {
      font-size: inherit;
      font-weight: bold;
      line-height: 1;
    }

    .progressBarWrapper {
      grid-column: 1 / 3;
      background-color: var(--yellow);
    }

    .whenever {
      font-size: 1.5rem;
      display: block;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo__wrapper">
      <img class="logo" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <h1 class="title">1 image says more than 1000 words</h1>
    <figure class="picture">
      <Image
        class={"picture__img"}
        src={UploadJpg}
        alt="a guy painting on canvas and a child's face"
      />
      <figcaption>
        <span class="label__small-text">snap and upload your</span>
        <span class="label__big-text">Pictures</span>
      </figcaption>
    </figure>
    <p class="description">
      <span class="bold">Your moments matter to us</span> After your visit, share
      your pictures - so your chapter becomes part of our story
    </p>
    <ProgressBar currentStep={3} backLink="/7" nextLink="/9" />
  </body>
</html>
