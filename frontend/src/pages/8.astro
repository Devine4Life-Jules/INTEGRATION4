---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import ProgressBar from "../components/ProgressBar.astro";
import UploadJpg from "../assets/images/upload.jpg";
import Image from "astro/components/Image.astro";
---

<style>
  body {
    background-color: var(--white);
    display: grid;
    grid-template-rows: auto auto auto 1fr max-content;
    grid-template-columns: 1fr;
    max-height: 100vh;
  }

  .logo__wrapper,
  .title {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .title {
    line-height: 1.3;
  }

  .label {
    background-color: var(--yellow);
  }

  .picture {
    height: auto;
    object-fit: cover;
    display: block;
    grid-row: 3/4;
    grid-column: 1/2;
  }

  .label {
    background-color: var(--yellow);
    grid-row: 3/4;
    grid-column: 1/2;
    z-index: 100;
    height: max-content;
    width: max-content;
    align-self: end;
    display: flex;
    gap: 0.4em;
    flex-direction: column;
    padding: 0.4em;
    line-height: 1;
    margin: var(--screen-padding);
  }

  .label__small-text {
    font-size: 1.125rem;
    font-weight: 300;
  }

  .label__big-text {
    font-size: 1.625rem;
    font-weight: 500;
  }

  .description {
    text-align: center;
    margin: var(--screen-padding);
  }

  @media (orientation: landscape) {
    body {
      grid-template-columns: auto auto;
      grid-template-rows: auto auto 1fr max-content;
      height: 100vh;
    }

    .logo__wrapper,
    .title {
      background: none;
    }

    .logo__wrapper {
      grid-column: 2/3;
      grid-row: 1/2;
      z-index: 10;
      padding: var(--screen-padding);
      justify-self: end;
    }

    .title {
      grid-column: 1/2;
      grid-row: 1/2;
      font-size: 4.375rem;
      padding-bottom: 0;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .picture {
      grid-column: 2/3;
      grid-row: 1 / 4;
      z-index: 1;
      height: 100%;
      overflow: hidden;
      object-fit: cover;
    }

    .label {
      grid-row: 2/3;
      margin-top: 1em;
    }

    .description {
      grid-row: 3/4;
      /* grid-row: 1/2; */
      align-self: end;
      display: flex;
      flex-direction: column;
      text-align: start;
      font-size: 1rem;
    }

      .text-container__title {
      font-size: 1.5rem;
    }

    .description .bold {
      font-size: 2.5rem;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="logo__wrapper">
      <img class="logo" src={AbbyLogoSvg.src} alt="Abby logo" />
    </div>
    <h1 class="title">
      <span class="title__highlight">1 image</span> says more than 1000 words
    </h1>
    <Image
      class={"picture"}
      src={UploadJpg}
      alt="a guy painting on canvas and a child's face"
    />
    <div class="label">
      <span class="label__small-text">snap and upload your</span>
      <span class="label__big-text">Pictures</span>
    </div>
    <p class="description">
      <span class="text-container__title">Your moments matter to us</span> After your visit, share
      your pictures - so your chapter becomes part of our story
    </p>
    <ProgressBar currentStep={3} backLink="/7" nextLink="/9" />
  </body>
</html>
