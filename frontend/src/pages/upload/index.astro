---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import AbbySvg from "../../assets/illustrations/abby-kortrijk.svg";
import { Image } from "astro:assets";
import UploadJpg from "../../assets/images/upload.jpg";
import ArrowUpSvg from "../../assets/icons/arrow-up.svg";
import DoneSvg from "../../assets/icons/done.svg";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
  }

  .picture {
    display: none;
  }

  .text-container {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .text-container__title {
    font-weight: 400;
    font-size: 2.4rem;
    line-height: 1.2;
    margin-bottom: 0.15em;
  }

  .text-container__title__highlight {
    font-weight: 700;
  }

  .logo {
    display: none;
  }

  .form {
    padding: var(--screen-padding);
    padding: var(--screen-padding);
    display: flex;
    flex-direction: column;
    max-width: 100vw;
    gap: 1em;
    margin: 0.7em 0;
  }

  .form__file__icon {
    display: none;
  }

  .form__file__text {
    display: none;
  }

  .form__file__input::file-selector-button {
    background: var(--purple);
    border: none;
    padding: 0.4em;
    font-weight: 500;
    margin-right: 0.6em;
  }

  .form__label {
    display: flex;
    flex-direction: column;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .form input,
  .form textarea {
    font-size: 1rem;
    font-weight: 400;
    border: var(--input-border-size) solid var(--black);
    padding: 0.5em 0.6em;
  }

  .form__consent-input {
    margin-right: 0.3em;
    margin-top: 0.5em;
  }

  .buttons {
    display: flex;
    padding: var(--screen-padding);
    align-items: center;
    justify-content: space-between;
  }

  @media (orientation: landscape) {
    body {
      grid-template-columns: auto auto;
      grid-template-rows: auto 1fr max-content;
    }

    .picture {
      display: block;
      grid-row: 1/3;
      object-fit: cover;
      height: 100%;
    }

    .text-container {
      background: none;
      grid-row: 1/2;
      grid-column: 2/3;
    }

    .text-container__title {
      font-size: 5rem;
    }

    .text-container__title__highlight {
      background-color: var(--blue);
    }

    .text-container__p {
      font-size: 1.563rem;
    }

    .logo {
      grid-row: 1/2;
      grid-column: 2/3;
      display: block;
      justify-self: end;
      margin: var(--screen-padding) var(--screen-padding) 0 0;
      width: 10rem;
    }

    .form {
      display: grid;
      grid-template-columns: minmax(10rem, 20rem) minmax(10rem, 21.5rem);
      height: max-content;
      gap: 0.9em 3em;
      padding-top: 0.3em;
    }

    .form__file__container {
      grid-row: 1/4;
      border: var(--input-border-size) dashed var(--black);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1em;
      padding: 2.5em 3em 2em 3em;
    }

    .form__file__input {
      display: none;
    }

    .form__file__icon,
    .form__file__icon-uploaded {
      display: initial;
      padding: 1.5em;
      border: 0.2em solid var(--black);
      border-radius: 100rem;
    }

    .form__file__text {
      display: initial;
      font-size: 1.25rem;
      text-align: center;
    }

    .form__file__button {
      background: none;
      border: none;
      text-decoration: underline;
      cursor: pointer;
    }

    .buttons {
      grid-column: 1/3;
      background-color: var(--yellow);
    }

    .solid-border {
      border-style: solid;
      border-color: var(--green);
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Image
      class={"picture"}
      src={UploadJpg}
      alt={"A man painting on a canvas and child's face"}
    />
    <img class="logo" src={AbbySvg.src} alt="Abby logo" />
    <div class="text-container">
      <h1 class="text-container__title">
        <span class="text-container__title__highlight">Upload</span> your chapter's
        picture
      </h1>
      <p class="text-container__p">
        <span class="bold">Share</span> the memories you made at ABBY
      </p>
    </div>
    <form id="form" class="form">
      <div class="form__file__container">
        <img
          class="form__file__icon"
          src={ArrowUpSvg.src}
          alt="Arrow up icon"
        />
        <img
          class="form__file__icon-uploaded hidden"
          alt="done icon"
          src={DoneSvg.src}
        />
        <p class="form__file__text">
          Drop your image here or <button class="form__file__button"
            >browse</button
          >
        </p>
        <input
          id="picture-input"
          class="form__file__input"
          name="picture"
          type="file"
          accept="image/jpeg, image/png, image/gif, image/heic, image/webp, image/avif"
        />
      </div>
      <label class="form__label"
        >Your Name or Nickname
        <input name="username" placeholder="Lucia" />
      </label>
      <label class="form__label"
        >Short Message
        <textarea placeholder="My experience was..." name="message" id="message"
        ></textarea>
      </label>
      <label
        ><input class="form__consent-input" type="checkbox" name="consent" />I
        agree that ABBY can display these pictures</label
      >
    </form>
    <div class="buttons">
      <a class="button button--back">Back</a>
      <button class="buttons__upload button">Upload</button>
    </div>
  </body>
</html>

<script>
  import { navigate } from "astro:transitions/client";
  import { API_URL } from "../../consts";
  import heic2any from "heic2any";

  // handle browse button
  const $browse = document.querySelector(
    ".form__file__button"
  ) as HTMLButtonElement;
  const $inputFile = document.querySelector(
    ".form__file__input"
  ) as HTMLInputElement;

  $browse.addEventListener("click", (e) => {
    e.preventDefault();

    $inputFile.click();
    $inputFile.addEventListener("change", () => {
      showImageUploaded();
    });
  });

  const $fileContainer = document.querySelector(
    ".form__file__container"
  ) as HTMLDivElement;
  const $fileIcon = document.querySelector(
    ".form__file__icon"
  ) as HTMLImageElement;
  const $fileIconUploaded = document.querySelector(
    ".form__file__icon-uploaded"
  ) as HTMLImageElement;
  $fileContainer.addEventListener("dragover", (e) => e.preventDefault());

  const IMAGE_SIZE = 920;

  const getImgOffset = (image: any, option: string) => {
    const imageCanvasRatio = image[option] / IMAGE_SIZE;
    const diffrence = image[option] - IMAGE_SIZE;
    const scaledDifference = diffrence / imageCanvasRatio;
    return scaledDifference / 2;
  };

  const getCroppedJpg = async (file: File) => {
    let blob: File | Blob = file;
    // Convert HEIC to JPEG if needed
    if (
      file.type === "image/heic" ||
      file.name.toLowerCase().endsWith(".heic")
    ) {
      blob = (await heic2any({
        blob: file,
        toType: "image/jpeg",
        quality: 0.8,
      })) as Blob;
    }
    // Optional: Resize/compress using Canvas
    const img = new Image();
    const canvas = document.createElement("canvas");
    return new Promise((resolve) => {
      img.src = URL.createObjectURL(blob);
      img.onload = () => {
        canvas.width = 920;
        canvas.height = 920;
        const ctx = canvas.getContext("2d") as CanvasRenderingContext2D;

        const offset =
          img.width < img.height
            ? getImgOffset(img, "height")
            : getImgOffset(img, "width");

        if (img.width < img.height) {
          ctx.drawImage(img, 0, -offset, canvas.width, canvas.height + offset);
        } else {
          ctx.drawImage(img, -offset, 0, canvas.width + offset, canvas.height);
        }

        // const $a = document.createElement("a");
        // $a.href = canvas.toDataURL();
        // $a.download = "img.png";
        // $a.click();
        canvas.toBlob((newBlob) => resolve(newBlob), "image/jpeg", 0.8);
        URL.revokeObjectURL(img.src);
      };
    });
  };

  $fileContainer.addEventListener("drop", async (e) => {
    e.preventDefault();

    if (!e.dataTransfer) return;
    if (!e.dataTransfer.files) return;

    const blob = (await getCroppedJpg(e.dataTransfer.files[0])) as Blob;
    const dataTransfer = new DataTransfer();
    const file = new File([blob], "activity.jpg");
    dataTransfer.items.add(file);

    $inputFile.files = dataTransfer.files;
    showImageUploaded();
  });

  const showImageUploaded = () => {
    $fileIcon.classList.add("hidden");
    $fileIconUploaded.classList.remove("hidden");
    $fileContainer.classList.add("solid-border");
  };

  const $form = document.querySelector("#form") as HTMLFormElement;
  const $submit = document.querySelector(
    ".buttons__upload"
  ) as HTMLButtonElement;
  $submit.addEventListener("click", async (e) => {
    e.preventDefault();
    const $fileInput = $form.querySelector(
      "#picture-input"
    ) as HTMLInputElement;

    if (!$fileInput.files || $fileInput.files.length === 0) return;

    const picture = $fileInput.files[0];
    console.log(picture);
    const res = await fetch(
      `${API_URL}/drupal/jsonapi/node/story/field_picture`,
      {
        method: "POST",
        headers: {
          Accept: "application/vnd.api+json",
          "Content-Type": "application/octet-stream",
          "Content-Disposition": `file; filename="${picture.name}"`,
        },
        body: picture,
      }
    );
    const resJson = await res.json();
    const pictureId = resJson?.data.id as string | undefined;

    if (!pictureId) {
      // !TODO handle error with UI
      console.error("pictureId is not defined!");
      return;
    }

    const data = new FormData($form);
    const usernname = data.get("username");
    const description = data.get("message");

    // !TODO handle error
    await fetch(`${API_URL}/drupal/jsonapi/node/story`, {
      method: "POST",
      headers: {
        "Content-Type": "application/vnd.api+json",
        Accept: "application/vnd.api+json",
      },
      body: JSON.stringify({
        data: {
          type: "node--story",
          attributes: {
            title: Date.now(),
            field_username: usernname,
            field_message: description,
          },
          relationships: {
            field_picture: {
              data: {
                type: "file--file",
                id: pictureId,
              },
            },
          },
        },
      }),
    });

    navigate("/upload/complete");
  });
</script>
