---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import AbbySvg from "../../assets/illustrations/abby-kortrijk.svg";
import { Image } from "astro:assets";
import UploadPng from "../../assets/images/upload.png";
import ArrowUpSvg from "../../assets/icons/arrow-up.svg";
---

<style>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
  }

  .picture {
    display: none;
  }

  .text-container {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .text-container__title {
    font-weight: 400;
    font-size: 2.4rem;
    line-height: 1.2;
    margin-bottom: 0.15em;
  }

  .text-container__title__highlight {
    font-weight: 700;
  }

  .logo {
    display: none;
  }

  .form {
    padding: var(--screen-padding);
    padding: var(--screen-padding);
    display: flex;
    flex-direction: column;
    max-width: 100vw;
    gap: 1em;
    margin: 0.7em 0;
  }

  .form__file__icon {
    display: none;
  }

  .form__file__text {
    display: none;
  }

  .form__file__input::file-selector-button {
    background: var(--purple);
    border: none;
    padding: 0.4em;
    font-weight: 500;
    margin-right: 0.6em;
  }

  .form__label {
    display: flex;
    flex-direction: column;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .form input,
  .form textarea {
    font-size: 1rem;
    font-weight: 400;
  }

  .form__consent-input {
    margin-right: 0.3em;
    margin-top: 0.5em;
  }

  .buttons {
    display: flex;
    padding: var(--screen-padding);
    align-items: center;
    justify-content: space-between;
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Image
      class={"picture"}
      src={UploadPng}
      alt={"A man painting on a canvas and child's face"}
    />
    <img class="logo" src={AbbySvg.src} alt="Abby logo" />
    <div class="text-container">
      <h1 class="text-container__title">
        <span class="text-container__title__highlight">Upload</span> your chapter's
        picture
      </h1>
      <p><span class="bold">Share</span> the memories you made at ABBY</p>
    </div>
    <form id="form" class="form">
      <div class="form__file__container">
        <img
          class="form__file__icon"
          src={ArrowUpSvg.src}
          alt="Arrow up icon"
        />
        <p class="form__file__text">
          Drop your image here or <button class="form__file__button"
            >browse</button
          >
        </p>
        <input
          id="picture-input"
          class="form__file__input"
          name="picture"
          type="file"
          accept="image/jpeg, image/png, image/gif, image/heic, image/webp, image/avif"
        />
      </div>
      <label class="form__label"
        >Your Name or Nickname
        <input name="username" placeholder="Lucia" />
      </label>
      <label class="form__label"
        >Short Message
        <textarea placeholder="My experience was..." name="message" id="message"
        ></textarea>
      </label>
      <label
        ><input class="form__consent-input" type="checkbox" name="consent" />I
        agree that ABBY can display these pictures</label
      >
    </form>
    <div class="buttons">
      <a class="button button--back">Back</a>
      <button class="button">Upload</button>
    </div>
  </body>
</html>

<script>
  import { API_URL } from "../../consts";

  const $form = document.querySelector("#form") as HTMLFormElement;
  const $submit = document.querySelector(".submit") as HTMLButtonElement;
  $submit.addEventListener("click", async (e) => {
    e.preventDefault();
    const $fileInput = $form.querySelector(
      "#picture-input"
    ) as HTMLInputElement;

    if (!$fileInput.files || $fileInput.files.length === 0) return;

    const picture = $fileInput.files[0];
    const res = await fetch(`${API_URL}/jsonapi/node/story/field_picture`, {
      method: "POST",
      headers: {
        Accept: "application/vnd.api+json",
        "Content-Type": "application/octet-stream",
        "Content-Disposition": `file; filename="${picture.name}"`,
      },
      body: picture,
    });
    const resJson = await res.json();
    const pictureId = resJson?.data.id as string | undefined;

    if (!pictureId) {
      // !TODO handle error with UI
      console.error("pictureId is not defined!");
      return;
    }

    const data = new FormData($form);
    const usernname = data.get("username");
    const description = data.get("message");

    await fetch(`${API_URL}/jsonapi/node/story`, {
      method: "POST",
      headers: {
        "Content-Type": "application/vnd.api+json",
        Accept: "application/vnd.api+json",
      },
      body: JSON.stringify({
        data: {
          type: "node--story",
          attributes: {
            title: Date.now(),
            field_username: usernname,
            field_description: description,
          },
          relationships: {
            field_picture: {
              data: {
                type: "file--file",
                id: pictureId,
              },
            },
          },
        },
      }),
    });
  });
</script>
