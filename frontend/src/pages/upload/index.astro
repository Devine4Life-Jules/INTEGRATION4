---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import AbbySvg from "../../assets/illustrations/abby-kortrijk.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- !TODO <img src="" alt=""> -->
    <div>
      <img src={AbbySvg.src} alt="Abby logo" />
      <h1>
        <span class="title__highlight">Upload</span> your chapter's picture
      </h1>
      <p><span class="bold">Share</span> the memories you made at ABBY</p>
      <form id="form">
        <input
          id="picture-input"
          name="picture"
          type="file"
          accept="image/jpeg, image/png, image/gif, image/heic, image/webo, image/avif"
        />
        <label
          >Your Name or Nickname
          <input name="username" placeholder="Lucia" />
        </label>
        <label
          >Short Message
          <textarea
            placeholder="My experience was..."
            name="message"
            id="message"></textarea>
        </label>
        <label
          ><input type="checkbox" name="consent" />I agree that ABBY can display
          these pictures</label
        >
      </form>
    </div>
    <div>
      <a>Back</a>
      <button>Upload</button>
    </div>
  </body>
</html>

<script>
  import { API_URL } from "../../consts";

  const $form = document.querySelector("#form") as HTMLFormElement;
  $form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const $fileInput = $form.querySelector(
      "#picture-input"
    ) as HTMLInputElement;

    if (!$fileInput.files || $fileInput.files.length === 0) return;

    const picture = $fileInput.files[0];
    const res = await fetch(`${API_URL}/jsonapi/node/story/field_picture`, {
      method: "POST",
      headers: {
        Accept: "application/vnd.api+json",
        "Content-Type": "application/octet-stream",
        "Content-Disposition": `file; filename="${picture.name}"`,
      },
      body: picture,
    });
    const resJson = await res.json();
    const pictureId = resJson?.data.id as string | undefined;

    if (!pictureId) {
      // !TODO handle error with UI
      console.error("pictureId is not defined!");
      return;
    }

    const data = new FormData($form);
    const usernname = data.get("username");
    const description = data.get("message");

    await fetch(`${API_URL}/jsonapi/node/story`, {
      method: "POST",
      headers: {
        "Content-Type": "application/vnd.api+json",
        Accept: "application/vnd.api+json",
      },
      body: JSON.stringify({
        data: {
          type: "node--story",
          attributes: {
            title: Date.now(),
            field_username: usernname,
            field_description: description,
          },
          relationships: {
            field_picture: {
              data: {
                type: "file--file",
                id: pictureId,
              },
            },
          },
        },
      }),
    });
  });
</script>
