---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<style>
  body {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto 1fr auto;
    height: 100vh;
  }

  body > * {
    grid-column: 1/3;
  }

  .top-container {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .logo {
    margin-bottom: 2em;
  }

  .title {
    line-height: 1.2;
    margin-bottom: 0.5em;
    font-size: 2.5rem;
  }

  .description {
    font-size: 1.25rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    margin: var(--screen-padding);
  }

  .form__label {
    display: flex;
    flex-direction: column;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .form__input {
    font-size: 1rem;
    font-weight: 300;
    padding: 0.5em 0.65em;
  }

  .back-button__background {
    grid-column: 1/2;
    width: max-content;
    margin: var(--screen-padding);
  }

  .copy-button {
    grid-column: 2/3;
    width: max-content;
    justify-self: end;
    margin: var(--screen-padding);
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <div class="top-container">
      <img class="logo" src={AbbyLogoSvg.src} alt="Abby logo" />
      <h1 class="title">
        <span class="title__highlight">Start a chapter</span> together
      </h1>
      <p class="description">
        <span class="bold">Some things are just better with a friend.</span> Invite
        someone to begin a Chapter with you — create, reflect, or explore side by
        side.
      </p>
    </div>
    <form class="form">
      <label class="form__label">
        Your Name
        <input class="form__input" type="text" placeholder="Lucia" />
      </label>
      <label class="form__label">
        Friends Name
        <input class="form__input" type="text" placeholder="Anna" />
      </label>
    </form>
    <!-- !TODO might have to handle different route here -->
    <div class="back-button__background">
      <a class="back-button button button--back" href="/">Back</a>
    </div>
    <button class="copy-button button">Copy invitation link</button>
  </body>
</html>
