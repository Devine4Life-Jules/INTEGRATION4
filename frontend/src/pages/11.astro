---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <img src={AbbyLogoSvg.src} alt="Abby logo" />
    <h1>Start a chapter together</h1>
    <p>
      <span class="bold">Some things are just better with a friend.</span> Invite
      someone to begin a Chapter with you — create, reflect, or explore side by side.
    </p>
    <form>
      <label>
        Your Name
        <input type="text" placeholder="Lucia" />
      </label>
      <label>
        Friends Name
        <input type="text" placeholder="Anna" />
      </label>
    </form>
    <div class="buttons">
      <!-- !TODO might have to handle different route here -->
      <a href="/">Our Shared Story</a>
      <button>Copy invitation link</button>
    </div>
  </body>
</html>
