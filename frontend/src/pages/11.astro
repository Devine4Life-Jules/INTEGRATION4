---
import { ClientRouter } from "astro:transitions";
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import AbbyLogoSvg from "../assets/illustrations/abby-kortrijk.svg";
import FriendsJpg from "../assets/images/friends.jpg";
import Image from "astro/components/Image.astro";
---

<style>
  body {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto 1fr max-content;
    height: 100vh;
  }

  body > * {
    grid-column: 1/3;
  }

  .picture {
    display: none;
  }
        
  .top-container {
    background-color: var(--yellow);
    padding: var(--screen-padding);
  }

  .logo {
    margin-bottom: 2em;
  }

  .title {
    line-height: 1.2;
    margin-bottom: 0.5em;
    font-size: 2.5rem;
  }

  .description {
    font-size: 1.25rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    margin: var(--screen-padding);
    gap: 1em;
    max-width: 20rem;
  }

  .form__label {
    display: flex;
    flex-direction: column;
    font-size: 1.25rem;
    font-weight: 500;
  }

  .form__input {
    font-size: 1rem;
    font-weight: 300;
    padding: 0.5em 0.65em;
  }

  .back-button__background {
    grid-column: 1/2;
    width: max-content;
    padding: var(--screen-padding);
  }

  .copy-button {
    grid-column: 2/3;
    width: max-content;
    justify-self: end;
    margin: var(--screen-padding);
  }

  @media (orientation: landscape) {
    body {
      grid-template-rows: auto auto 1fr auto;
    }

    .picture {
      display: initial;
      grid-column: 1/2;
      grid-row: 1/4;
      object-fit: cover;
      height: 100%;
    }

    .logo {
      display: none;
    }

    .top-container {
      grid-column: 2/3;
      background: none;
      padding-bottom: 2em;
    }

    .title {
      font-size: 4.375rem;
      margin-bottom: 0.3em;
    }

    .title__highlight {
      background-color: var(--blue);
    }

    .description {
      font-size: 1.563rem;
      max-width: 33rem;
    }

    .form {
      grid-row: 2/3;
      grid-column: 2/3;
      margin-top: 0.2em;
      margin-bottom: 0.2em;
    }

    .back-button__background {
      background-color: var(--yellow);
      grid-column: 1/3;
      width: 100%;
    }

    .back-button {
      width: max-content;
    }

    .copy-button {
      margin-top: 1.3em;
      grid-row: 3/4;
      align-self: flex-start;
      justify-self: flex-start;
    }
  }
</style>

<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <ClientRouter />
  </head>
  <body>
    <Image class={"picture"} src={FriendsJpg} alt={"friends"} />
    <div class="top-container">
      <img class="logo" src={AbbyLogoSvg.src} alt="Abby logo" />
      <h1 class="title">
        <span class="title__highlight">Start a chapter</span> together
      </h1>
      <p class="description">
        <span class="bold">Some things are just better with a friend.</span> Invite
        someone to begin a Chapter with you — create, reflect, or explore side by
        side.
      </p>
    </div>
    <form class="form">
      <label class="form__label">
        Your Name
        <input class="form__input" type="text" placeholder="Lucia" />
      </label>
      <label class="form__label">
        Friends Name
        <input class="form__input" type="text" placeholder="Anna" />
      </label>
    </form>
    <!-- !TODO might have to handle different route here -->
    <div class="back-button__background">
      <a class="back-button button button--back" href="/">Back</a>
    </div>
    <button class="copy-button button">Copy invitation link</button>
  </body>
</html>
